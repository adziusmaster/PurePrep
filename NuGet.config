<?xml version="1.0" encoding="utf-8"?>
<!--
  Pinned to nuget.org so restore is identical on a developer machine and in CI.
  Without this the restore inherits whatever feeds the machine's global NuGet.config lists,
  which in practice has meant an unreachable corporate proxy aborting the restore.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
