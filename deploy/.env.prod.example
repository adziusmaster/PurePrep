# Copy to .env next to your deploy and fill in real values. Never commit .env.
#   cp deploy/.env.prod.example .env

# Google AI Studio (Gemini) API key. Server-side only; the app never embeds it.
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-flash-lite-latest).
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: shared secret guarding POST /api/dev/grant (leave empty to disable).
DEV_SECRET=

# Optional: shared secret guarding the /api/admin/promo endpoints (create/list/revoke
# tester promo codes). Leave empty to disable those admin endpoints entirely.
# Used by deploy/promo.sh (export ADMIN_SECRET before running it).
ADMIN_SECRET=
