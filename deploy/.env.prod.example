# Copy to .env next to your deploy and fill in real values. Never commit .env.
#   cp deploy/.env.prod.example .env

# Google AI Studio (Gemini) API key. Server-side only; the app never embeds it.
GEMINI_API_KEY=

# Optional: override the Gemini model (defaults to gemini-flash-lite-latest).
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: shared secret guarding POST /api/dev/grant (leave empty to disable).
DEV_SECRET=

# Optional: shared secret guarding the /api/admin/promo endpoints (create/list/revoke
# tester promo codes). Leave empty to disable those admin endpoints entirely.
# Used by deploy/promo.sh (export ADMIN_SECRET before running it).
ADMIN_SECRET=

# --- Google Play purchase validation (REQUIRED in production) -------------------------------
# Absolute path on the host to the service-account JSON key with Android Publisher access.
# The server will not start without it. See docs/play-validation-setup.md for how to create one.
PLAY_KEY_PATH=/opt/pureprep/secrets/play-service-account.json

# Play package name. Only change this if the app id changes.
PLAY_PACKAGE_NAME=com.adziusmaster.pureprep

# --- Free-credit seed cap --------------------------------------------------------------------
# Salt for hashing client IPs. Generate once and never change it:
#   openssl rand -hex 32
# Changing it resets the per-origin cap; leaking it makes the stored hashes reversible.
IP_HASH_SALT=
