<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PurePrep"
             xmlns:loc="clr-namespace:PurePrep.Localization"
             x:Class="PurePrep.App">
    <Application.Resources>
        <ResourceDictionary>
            <local:StringNotNullOrEmptyConverter x:Key="StringNotNullOrEmptyConverter" />
            <local:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <local:RecipeImageConverter x:Key="RecipeImage" />
            <local:RecipeCardMetaConverter x:Key="RecipeCardMeta" />
            <local:FirstLetterConverter x:Key="FirstLetterConverter" />
            <local:TimerChipConverter x:Key="TimerChip" />
            <loc:ResourceFormatConverter x:Key="ResourceFormatConverter" />
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
