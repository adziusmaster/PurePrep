<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PurePrep"
             xmlns:loc="clr-namespace:PurePrep.Localization"
             xmlns:icons="clr-namespace:PurePrep.Resources.Styles"
             x:Class="PurePrep.Controls.AddRecipeButton">

    <!-- Home's one way in to adding a recipe: the floating "+ Add recipe" pill, and the same pill in
         the empty-library state. Inherits Home's BindingContext (RecipeLibraryViewModel): while any
         import runs it turns into an "Importing…" spinner, the progress cue the old URL box used to give. -->
    <Border BackgroundColor="{DynamicResource Lime}" StrokeThickness="0" StrokeShape="RoundRectangle 28"
            Padding="20,0,24,0" HeightRequest="56"
            local:TapFeedback.IsEnabled="True" AutomationProperties.IsInAccessibleTree="True"
            AutomationProperties.Name="{loc:Translate AddRecipe}">
        <Border.Shadow>
            <Shadow Brush="Black" Opacity="0.25" Radius="16" Offset="0,4" />
        </Border.Shadow>
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
        <Grid>
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center"
                                   IsVisible="{Binding IsImporting, Converter={StaticResource InvertedBoolConverter}}">
                <Label Style="{StaticResource IconLabel}" Text="{x:Static icons:Icons.Add}"
                       TextColor="{DynamicResource LimeInk}" FontSize="24" />
                <Label Text="{loc:Translate AddRecipe}" TextColor="{DynamicResource LimeInk}" FontSize="16"
                       FontFamily="OpenSansSemibold" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center" IsVisible="{Binding IsImporting}">
                <ActivityIndicator IsRunning="{Binding IsImporting}" Color="{DynamicResource LimeInk}"
                                   WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                <Label Text="{loc:Translate ImportingRecipe}" TextColor="{DynamicResource LimeInk}" FontSize="16"
                       FontFamily="OpenSansSemibold" VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>
    </Border>
</ContentView>
