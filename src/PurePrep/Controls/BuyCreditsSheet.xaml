<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PurePrep"
             xmlns:controls="clr-namespace:PurePrep.Controls"
             xmlns:loc="clr-namespace:PurePrep.Localization"
             x:Class="PurePrep.Controls.BuyCreditsSheet"
             x:Name="Root"
             IsVisible="{Binding IsOpen, Source={x:Reference Root}}"
             InputTransparent="False">

    <!-- The single, shared "buy Smart Credits" sheet used by BOTH the main paywall and the Settings
         buy-credits row, so the purchase menu looks and reads identically everywhere. Host pages set
         the copy (Title/Subtitle), feed the live packs, and wire Buy/Dismiss. -->
    <Grid>
        <!-- Light scrim; tap outside to dismiss. Background is blurred natively on Android by the host. -->
        <BoxView Color="#33000000"
                 AutomationProperties.IsInAccessibleTree="True"
                 AutomationProperties.Name="{loc:Translate Close}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding DismissCommand, Source={x:Reference Root}}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource LimeDim}"
                StrokeThickness="1" Padding="20" Margin="14,0,14,18" StrokeShape="RoundRectangle 24"
                VerticalOptions="End" MaximumWidthRequest="720" HorizontalOptions="Center">
            <VerticalStackLayout Spacing="16">

                <!-- Header: lime credit glyph, title + subtitle, and a close button. -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border WidthRequest="44" HeightRequest="44" BackgroundColor="{DynamicResource LimeWash}"
                            Stroke="{DynamicResource LineSoft}" StrokeThickness="1" StrokeShape="RoundRectangle 14"
                            VerticalOptions="Start">
                        <Label Text="&#9733;" TextColor="{DynamicResource LimeBright}" FontSize="20"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                        <Label Text="{Binding Title, Source={x:Reference Root}}" TextColor="{DynamicResource Ink}"
                               FontSize="18" FontAttributes="Bold" />
                        <Label Text="{Binding Subtitle, Source={x:Reference Root}}"
                               TextColor="{DynamicResource Muted}" FontSize="13.5" LineHeight="1.25" />
                    </VerticalStackLayout>
                    <Border Grid.Column="2" WidthRequest="40" HeightRequest="40"
                            BackgroundColor="{DynamicResource BgElevated}" Stroke="{DynamicResource Line}"
                            StrokeThickness="1" StrokeShape="RoundRectangle 20"
                            VerticalOptions="Start" HorizontalOptions="End"
                            local:TapFeedback.IsEnabled="True" AutomationProperties.IsInAccessibleTree="True"
                            AutomationProperties.Name="{loc:Translate Close}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DismissCommand, Source={x:Reference Root}}" />
                        </Border.GestureRecognizers>
                        <Label Text="&#10005;" TextColor="{DynamicResource Muted}" FontSize="14"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Pack picker: one on-brand card per pack (hidden where in-app billing is unavailable). -->
                <VerticalStackLayout Spacing="10"
                                     BindableLayout.ItemsSource="{Binding Packs, Source={x:Reference Root}}"
                                     IsVisible="{Binding IsBillingSupported, Source={x:Reference Root}}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <controls:CreditPackCard Credits="{Binding Credits}" Price="{Binding DisplayPrice}"
                                                     TapCommand="{Binding BuyCommand, Source={x:Reference Root}}"
                                                     TapCommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Fallback for platforms without in-app billing (iOS/web preview). -->
                <Button Text="{loc:Translate TopUpCredits}"
                        Command="{Binding TopUpCommand, Source={x:Reference Root}}"
                        IsVisible="{Binding IsBillingSupported, Source={x:Reference Root}, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="{DynamicResource Lime}" TextColor="{DynamicResource LimeInk}"
                        FontAttributes="Bold" FontSize="15" HeightRequest="50" CornerRadius="15" />

                <!-- Why credits cost money: keeps the pricing honest and on-brand. -->
                <Border BackgroundColor="{DynamicResource BgElevated}" Stroke="Transparent" Padding="14"
                        StrokeShape="RoundRectangle 16">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Translate WhyCreditsTitle}" TextColor="{DynamicResource Ink}"
                               FontSize="13.5" FontAttributes="Bold" />
                        <Label Text="{loc:Translate WhyCreditsBody}" TextColor="{DynamicResource Muted}"
                               FontSize="12.5" LineHeight="1.3" />
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator IsRunning="{Binding IsBusy, Source={x:Reference Root}}"
                                   IsVisible="{Binding IsBusy, Source={x:Reference Root}}"
                                   Color="{DynamicResource Lime}" HeightRequest="24" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
