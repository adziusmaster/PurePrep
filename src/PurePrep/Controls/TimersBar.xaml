<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PurePrep"
             xmlns:icons="clr-namespace:PurePrep.Resources.Styles"
             x:Class="PurePrep.Controls.TimersBar"
             x:Name="Root"
             IsVisible="False">

    <!-- App-wide running-timers bar: shown on Home, the recipe detail page and Settings whenever any
         cook timer is running (Focus Mode itself already shows timers inline, so it never hosts this).
         Tapping it jumps back into Focus Mode at the step the timer was started from. -->
    <Border BackgroundColor="{DynamicResource LimeWash}" Stroke="{DynamicResource Lime}" StrokeThickness="1"
            Padding="16,12" Margin="0,0,0,10" StrokeShape="RoundRectangle 16"
            local:TapFeedback.IsEnabled="True" AutomationProperties.IsInAccessibleTree="True"
            AutomationProperties.Name="{Binding Source={x:Reference Root}, Path=Summary}">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Label Style="{StaticResource IconLabel}" Text="{x:Static icons:Icons.Timer}"
                   TextColor="{DynamicResource LimeBright}" FontSize="18" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="{Binding Source={x:Reference Root}, Path=Summary}"
                   TextColor="{DynamicResource Ink}" FontSize="14" FontAttributes="Bold"
                   LineBreakMode="TailTruncation" VerticalOptions="Center" />
            <Label Grid.Column="2" Text="&#8250;" TextColor="{DynamicResource LimeBright}" FontSize="18"
                   VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>
