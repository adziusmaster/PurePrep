<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PurePrep"
             xmlns:loc="clr-namespace:PurePrep.Localization"
             xmlns:controls="clr-namespace:PurePrep.Controls"
             xmlns:icons="clr-namespace:PurePrep.Resources.Styles"
             x:Class="PurePrep.FocusPage"
             x:Name="FocusRoot"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource Bg}">

    <!-- No bottom padding on this root (the nav row carries its own margin) so the bottom sheets,
         which span every row, dock flush to the bottom edge. -->
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="16"
          MaximumWidthRequest="760" HorizontalOptions="Center">

        <!-- Top bar: title + "Step N of M", the ingredients toggle, and the ⋯ cooking-options sheet. -->
        <controls:TopBar Title="{Binding Recipe.Title}" Subtitle="{Binding StepLabel}" BackTapped="OnBackTapped">
            <controls:TopBar.Actions>
                <HorizontalStackLayout Spacing="8">
                    <!-- Ingredients ⇄ step: lit while the list is open, when its name reads "Step". -->
                    <Border Style="{StaticResource IconButton}" IsVisible="{Binding HasIngredients}"
                            AutomationProperties.Name="{Binding IngredientsToggleLabel}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleIngredientsCommand}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding ShowIngredients}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource LimeWash}" />
                                <Setter Property="Stroke" Value="{DynamicResource Lime}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Style="{StaticResource IconLabel}" Text="{x:Static icons:Icons.Text}">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding ShowIngredients}" Value="True">
                                    <Setter Property="TextColor" Value="{DynamicResource LimeBright}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>
                    <Border Style="{StaticResource IconButton}" AutomationProperties.Name="{loc:Translate CookingOptions}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOptionsTapped" />
                        </Border.GestureRecognizers>
                        <Label Style="{StaticResource IconLabel}" Text="{x:Static icons:Icons.Tune}" />
                    </Border>
                </HorizontalStackLayout>
            </controls:TopBar.Actions>
        </controls:TopBar>

        <!-- Progress -->
        <ProgressBar Grid.Row="1" Margin="20,0" Progress="{Binding Progress}" ProgressColor="{DynamicResource Lime}"
                     BackgroundColor="{DynamicResource Line}" HeightRequest="4" />


        <!-- Step area (hidden while the ingredients panel is open): notes (first step only) above a
             swipeable carousel of step cards, this step's "You'll need" ingredients below it, then the
             fixed cooking controls (timers, read/stop, voice) so a running countdown never rotates out
             of reach. -->
        <Grid Grid.Row="2" Margin="20,0" RowDefinitions="Auto,*,Auto,Auto" RowSpacing="14"
              IsVisible="{Binding ShowIngredients, Converter={StaticResource InvertedBoolConverter}}">

            <!-- The cook's own notes, surfaced once at the start rather than buried in the ingredients
                 panel the whole time. -->
            <Border Grid.Row="0" BackgroundColor="{DynamicResource LimeWash}" Stroke="{DynamicResource LineSoft}"
                    StrokeThickness="1" Padding="16,14" StrokeShape="RoundRectangle 16"
                    IsVisible="{Binding ShowNotes}">
                <VerticalStackLayout Spacing="4">
                    <Label Text="{loc:Translate YourNotes}" TextColor="{DynamicResource LimeBright}" FontSize="11"
                           CharacterSpacing="1.4" FontAttributes="Bold" />
                    <Label Text="{Binding Notes}" TextColor="{DynamicResource Ink}" FontSize="14.5" LineHeight="1.3" />
                </VerticalStackLayout>
            </Border>

            <!-- Rotate/swipe horizontally to move between steps. Position is two-way bound so the nav
                 buttons and voice commands keep the carousel in sync. -->
            <CarouselView Grid.Row="1" ItemsSource="{Binding Steps}" Loop="False"
                          Position="{Binding CurrentStepIndex, Mode=TwoWay}"
                          PeekAreaInsets="12" HorizontalScrollBarVisibility="Never">
                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource LineSoft}"
                                StrokeThickness="1" Padding="22,20" StrokeShape="RoundRectangle 22"
                                Margin="4,0" VerticalOptions="Fill">
                            <controls:StepInstructionView Text="{Binding Instruction}" />
                        </Border>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>

            <!-- "You'll need": this step's ingredients, resolved from RecipeStep.IngredientRefs. Only
                 v2+ recipes carry refs, so this stays hidden for older, plain-list recipes. -->
            <VerticalStackLayout Grid.Row="2" Spacing="8" IsVisible="{Binding HasStepIngredients}">
                <Label Text="{loc:Translate YoullNeed}" TextColor="{DynamicResource Muted}" FontSize="11"
                       CharacterSpacing="1.6" FontAttributes="Bold" />
                <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding CurrentStepIngredients}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource LineSoft}"
                                    StrokeThickness="1" Padding="13,8" MinimumHeightRequest="36"
                                    StrokeShape="RoundRectangle 18" Margin="0,0,8,8">
                                <Label Text="{Binding .}" TextColor="{DynamicResource Ink}" FontSize="13.5"
                                       VerticalOptions="Center" />
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>

            <ScrollView Grid.Row="3" VerticalScrollBarVisibility="Never" MaximumHeightRequest="240">
            <VerticalStackLayout Spacing="12">

                <!-- Active countdowns: several timers can run at once, each named and stoppable. A
                     range timer at its minimum shows "Check now" plus a "+2 min" button alongside
                     Stop instead of the plain countdown. -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasActiveTimers}"
                                     BindableLayout.ItemsSource="{Binding ActiveTimers}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{DynamicResource LimeWash}" Stroke="{DynamicResource Lime}"
                                    StrokeThickness="1" Padding="16,14" StrokeShape="RoundRectangle 16">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Label}" TextColor="{DynamicResource LimeBright}"
                                               FontSize="12.5" CharacterSpacing="1.2" FontAttributes="Bold"
                                               LineBreakMode="TailTruncation" MaxLines="1" />
                                        <Label Text="{Binding Display}" TextColor="{DynamicResource Ink}"
                                               FontSize="34" FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" BackgroundColor="{DynamicResource Lime}"
                                            Stroke="{DynamicResource Lime}" StrokeThickness="1" Padding="14,12"
                                            MinimumHeightRequest="48" StrokeShape="RoundRectangle 12" VerticalOptions="Center"
                                            IsVisible="{Binding ShowExtend}" local:TapFeedback.IsEnabled="True"
                                            AutomationProperties.IsInAccessibleTree="True" AutomationProperties.Name="{loc:Translate AddTwoMinutes}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding ExtendCommand}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{loc:Translate AddTwoMinutes}" TextColor="{DynamicResource LimeInk}" FontSize="13"
                                               FontAttributes="Bold" VerticalOptions="Center" />
                                    </Border>
                                    <Border Grid.Column="2" BackgroundColor="{DynamicResource Surface}"
                                            Stroke="{DynamicResource Line}" StrokeThickness="1" Padding="16,12"
                                            MinimumHeightRequest="48" StrokeShape="RoundRectangle 12" VerticalOptions="Center"
                                            local:TapFeedback.IsEnabled="True" AutomationProperties.IsInAccessibleTree="True" AutomationProperties.Name="{loc:Translate Stop}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding StopCommand}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{loc:Translate Stop}" TextColor="{DynamicResource Danger}" FontSize="13.5"
                                               FontAttributes="Bold" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- One wrapping flow of at most two lines: the compact read-aloud + voice icon pair
                     always opens line one (never hidden), then the step's timer chips; a "+N more"
                     chip takes the last slot when they don't all fit and opens the sheet of every
                     timer in the step. A chip starts its timer on one tap (no naming dialog); its small
                     pencil target opens the edit sheet to rename or adjust the minutes first. -->
                <controls:TimerChipsFlow Timers="{Binding CurrentStepTimers}" MoreTapped="OnMoreTimersTapped">
                    <controls:TimerChipsFlow.Leading>
                        <HorizontalStackLayout Spacing="6">
                            <!-- Read this step aloud (Play ⇄ Stop while speaking). -->
                            <Border Style="{StaticResource IconButton}" WidthRequest="40" HeightRequest="40"
                                    BackgroundColor="{DynamicResource BgElevated}" Stroke="{DynamicResource LineSoft}"
                                    VerticalOptions="Center" IsVisible="{Binding CanReadAloud}"
                                    AutomationProperties.Name="{loc:Translate ReadStep}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleReadCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsSpeaking}" Value="True">
                                        <Setter Property="AutomationProperties.Name" Value="{loc:Translate StopReading}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Style="{StaticResource IconLabel}" Text="{x:Static icons:Icons.Play}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsSpeaking}" Value="True">
                                            <Setter Property="Text" Value="{x:Static icons:Icons.Stop}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>

                            <!-- Hands-free voice navigation, only where speech recognition exists; lit while listening. -->
                            <Border Style="{StaticResource IconButton}" WidthRequest="40" HeightRequest="40"
                                    BackgroundColor="{DynamicResource BgElevated}" Stroke="{DynamicResource LineSoft}"
                                    VerticalOptions="Center" IsVisible="{Binding IsVoiceSupported}"
                                    AutomationProperties.Name="{loc:Translate VoiceControl}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleVoiceCommand}" />
                                </Border.GestureRecognizers>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsListening}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource Lime}" />
                                        <Setter Property="Stroke" Value="{DynamicResource Lime}" />
                                        <Setter Property="AutomationProperties.Name" Value="{loc:Translate VoiceListening}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Label Style="{StaticResource IconLabel}" Text="{x:Static icons:Icons.Mic}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsListening}" Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource LimeInk}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </HorizontalStackLayout>
                    </controls:TimerChipsFlow.Leading>
                    <controls:TimerChipsFlow.ChipTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Lime}"
                                    StrokeThickness="1" Padding="2" MinimumHeightRequest="40"
                                    StrokeShape="RoundRectangle 12"
                                    AutomationProperties.IsInAccessibleTree="True"
                                    AutomationProperties.Name="{Binding ., Converter={StaticResource TimerChip}}">
                                <HorizontalStackLayout Spacing="0" VerticalOptions="Center">
                                    <Border Padding="7,6,5,6" StrokeThickness="0" local:TapFeedback.IsEnabled="True">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference FocusRoot}, Path=BindingContext.StartTimerCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                            <Label Style="{StaticResource IconLabel}" Text="{x:Static icons:Icons.Timer}"
                                                   FontSize="13" TextColor="{DynamicResource Lime}" />
                                            <Label Text="{Binding ., Converter={StaticResource TimerChip}}" TextColor="{DynamicResource Ink}"
                                                   FontSize="13" FontAttributes="Bold" VerticalOptions="Center"
                                                   MaximumWidthRequest="180" LineBreakMode="TailTruncation" MaxLines="1" />
                                        </HorizontalStackLayout>
                                    </Border>
                                    <Border WidthRequest="26" HeightRequest="26" BackgroundColor="{DynamicResource BgElevated}"
                                            Stroke="{DynamicResource LineSoft}" StrokeThickness="1" StrokeShape="RoundRectangle 8"
                                            VerticalOptions="Center"
                                            local:TapFeedback.IsEnabled="True" AutomationProperties.IsInAccessibleTree="True"
                                            AutomationProperties.Name="{loc:Translate EditTimer}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference FocusRoot}, Path=BindingContext.EditTimerCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Style="{StaticResource IconLabel}" Text="{x:Static icons:Icons.Edit}"
                                               FontSize="12" TextColor="{DynamicResource Muted}" />
                                    </Border>
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </controls:TimerChipsFlow.ChipTemplate>
                </controls:TimerChipsFlow>

                <Label Text="{loc:Translate FocusHint}" IsVisible="{Binding ShowFocusHint}"
                       TextColor="{DynamicResource Muted}" FontSize="13.5" />

                <!-- Tells the cook exactly what to say, with the words in the recipe's language; only
                     while voice control is listening, so it doesn't cost space the rest of the time. -->
                <Label Text="{Binding VoiceCommandsHint}" IsVisible="{Binding IsListening}"
                       TextColor="{DynamicResource Muted}" FontSize="12.5" />
            </VerticalStackLayout>
          </ScrollView>
        </Grid>

        <!-- Ingredients panel: plain read-only list (no checkboxes — those used to lose the cook's
             place when the screen dimmed), followed by their own notes when present. -->
        <Border Grid.Row="2" Margin="20,0" BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource LineSoft}"
                StrokeThickness="1" Padding="8,4" StrokeShape="RoundRectangle 22" VerticalOptions="Fill"
                IsVisible="{Binding ShowIngredients}">
            <ScrollView>
                <VerticalStackLayout Padding="14,12" Spacing="14">
                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding AllIngredients}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Label Text="{Binding .}" TextColor="{DynamicResource Ink}" FontSize="16"
                                       LineHeight="1.25" Padding="0,10"
                                       AutomationProperties.IsInAccessibleTree="True"
                                       AutomationProperties.Name="{Binding .}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4"
                                         IsVisible="{Binding Notes, Converter={StaticResource StringNotNullOrEmptyConverter}}">
                        <BoxView HeightRequest="1" Color="{DynamicResource Line}" Margin="0,0,0,6" />
                        <Label Text="{loc:Translate YourNotes}" TextColor="{DynamicResource Muted}" FontSize="11"
                               CharacterSpacing="1.4" FontAttributes="Bold" />
                        <Label Text="{Binding Notes}" TextColor="{DynamicResource Ink}" FontSize="14.5" LineHeight="1.3" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- Navigation -->
        <Grid Grid.Row="3" Margin="20,0,20,18" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Text="{loc:Translate Back}" Command="{Binding PreviousCommand}" BackgroundColor="{DynamicResource Surface}"
                    TextColor="{DynamicResource Muted}" FontAttributes="Bold" CornerRadius="16" HeightRequest="56" />
            <Button Grid.Column="1" Text="{Binding PrimaryActionLabel}" Command="{Binding AdvanceCommand}"
                    BackgroundColor="{DynamicResource Lime}" TextColor="{DynamicResource LimeInk}"
                    FontAttributes="Bold" FontSize="16" CornerRadius="16" HeightRequest="56" />
        </Grid>

        <!-- ⋯ cooking options: read-aloud + keep-screen-on, opened from the top bar. -->
        <controls:OptionsSheet x:Name="OptionsSheet" Grid.RowSpan="4" />

        <!-- Every timer of the step, opened from the "+N more" chip: label · duration with Start and
             the pencil, or the live countdown while that timer runs. A row's pencil swaps this sheet
             for the edit sheet. -->
        <controls:BottomSheet x:Name="StepTimersSheet" Grid.RowSpan="4" Cancelled="OnStepTimersCancelled">
            <VerticalStackLayout Spacing="0">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                    <Label Text="{loc:Translate StepTimersTitle}" Style="{StaticResource SheetTitle}"
                           VerticalOptions="Center" />
                    <Border Grid.Column="1" WidthRequest="40" HeightRequest="40"
                            BackgroundColor="{DynamicResource Bg}" StrokeThickness="0" StrokeShape="RoundRectangle 20"
                            local:TapFeedback.IsEnabled="True" AutomationProperties.IsInAccessibleTree="True"
                            AutomationProperties.Name="{loc:Translate Close}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnStepTimersCancelled" />
                        </Border.GestureRecognizers>
                        <Label Style="{StaticResource IconLabel}" Text="{x:Static icons:Icons.Close}"
                               TextColor="{DynamicResource Muted}" FontSize="18" />
                    </Border>
                </Grid>

                <ScrollView MaximumHeightRequest="440" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="0" BindableLayout.ItemsSource="{Binding StepTimerRows}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12" MinimumHeightRequest="60">
                                    <Label Style="{StaticResource IconLabel}" Text="{x:Static icons:Icons.Timer}"
                                           FontSize="18" TextColor="{DynamicResource Lime}" />
                                    <Label Grid.Column="1" Text="{Binding Timer, Converter={StaticResource TimerChip}}"
                                           TextColor="{DynamicResource Ink}" FontSize="15.5" FontAttributes="Bold"
                                           VerticalOptions="Center" LineBreakMode="TailTruncation" MaxLines="2" />
                                    <!-- Start, or the running countdown in its place. -->
                                    <Border Grid.Column="2" BackgroundColor="{DynamicResource Lime}" Stroke="{DynamicResource Lime}"
                                            StrokeThickness="1" Padding="16,0" MinimumHeightRequest="44" StrokeShape="RoundRectangle 12"
                                            VerticalOptions="Center" local:TapFeedback.IsEnabled="True"
                                            IsVisible="{Binding IsRunning, Converter={StaticResource InvertedBoolConverter}}"
                                            AutomationProperties.IsInAccessibleTree="True" AutomationProperties.Name="{loc:Translate StartTimer}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference FocusRoot}, Path=BindingContext.StartTimerCommand}"
                                                CommandParameter="{Binding Timer}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{loc:Translate Start}" TextColor="{DynamicResource LimeInk}" FontSize="14"
                                               FontAttributes="Bold" VerticalOptions="Center" />
                                    </Border>
                                    <Label Grid.Column="2" Text="{Binding Display}" IsVisible="{Binding IsRunning}"
                                           TextColor="{DynamicResource LimeBright}" FontSize="18" FontAttributes="Bold"
                                           VerticalOptions="Center" />
                                    <Border Grid.Column="3" WidthRequest="40" HeightRequest="40" BackgroundColor="{DynamicResource BgElevated}"
                                            Stroke="{DynamicResource LineSoft}" StrokeThickness="1" StrokeShape="RoundRectangle 10"
                                            VerticalOptions="Center" local:TapFeedback.IsEnabled="True"
                                            AutomationProperties.IsInAccessibleTree="True" AutomationProperties.Name="{loc:Translate EditTimer}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference FocusRoot}, Path=BindingContext.EditTimerCommand}"
                                                CommandParameter="{Binding Timer}" />
                                        </Border.GestureRecognizers>
                                        <Label Style="{StaticResource IconLabel}" Text="{x:Static icons:Icons.Edit}"
                                               FontSize="15" TextColor="{DynamicResource Muted}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>
            </VerticalStackLayout>
        </controls:BottomSheet>

        <!-- Timer edit sheet: rename/adjust minutes before starting. Chips start instantly with no
             prompt; this is the only way to change what's about to start. Kept inline (rather than a
             separate control) since it is Focus-Mode-specific and needs no reuse elsewhere. -->
        <controls:BottomSheet x:Name="TimerEditSheet" Grid.RowSpan="4" Cancelled="OnTimerEditCancelled">
            <VerticalStackLayout Spacing="0">
                <Label Text="{loc:Translate EditTimer}" Style="{StaticResource SheetTitle}" />

                <Label Text="{loc:Translate TimerLabel}" Style="{StaticResource SheetFieldLabel}" Margin="0,20,0,8" />
                <Border Style="{StaticResource SheetField}">
                    <Entry x:Name="TimerLabelEntry" TextColor="{DynamicResource Ink}" BackgroundColor="Transparent"
                           FontSize="16" MaxLength="40" />
                </Border>

                <Label Text="{loc:Translate TimerMinutes}" Style="{StaticResource SheetFieldLabel}" Margin="0,16,0,8" />
                <Border Style="{StaticResource SheetField}">
                    <Entry x:Name="TimerMinutesEntry" TextColor="{DynamicResource Ink}" BackgroundColor="Transparent"
                           FontSize="16" Keyboard="Numeric" MaxLength="3" />
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,24,0,0">
                    <Button Grid.Column="0" Text="{loc:Translate Cancel}" Clicked="OnTimerEditCancelled"
                            Style="{StaticResource SheetSecondaryButton}" />
                    <Button Grid.Column="1" Text="{loc:Translate Start}" Clicked="OnTimerEditStartClicked"
                            Style="{StaticResource SheetPrimaryButton}" />
                </Grid>
            </VerticalStackLayout>
        </controls:BottomSheet>
    </Grid>
</ContentPage>
