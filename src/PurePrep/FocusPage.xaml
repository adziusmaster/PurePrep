<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PurePrep"
             xmlns:loc="clr-namespace:PurePrep.Localization"
             x:Class="PurePrep.FocusPage"
             x:Name="FocusRoot"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource Bg}">

    <Grid Padding="20,12,20,18" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="16"
          MaximumWidthRequest="760" HorizontalOptions="Center">

        <!-- Top bar: back + keep-awake toggle -->
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Surface}"
                    Stroke="{DynamicResource Line}" StrokeThickness="1" StrokeShape="RoundRectangle 14"
                    local:TapFeedback.IsEnabled="True" AutomationProperties.IsInAccessibleTree="True" AutomationProperties.Name="{loc:Translate Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Label Text="&#8249;" TextColor="{DynamicResource Ink}" FontSize="26"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Grid.Column="1" Text="{loc:Translate FocusMode}" TextColor="{DynamicResource Lime}" FontSize="12"
                   CharacterSpacing="2.2" FontAttributes="Bold"
                   VerticalOptions="Center" HorizontalOptions="Center" />

            <Border Grid.Column="2" BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                    StrokeThickness="1" Padding="12,6" StrokeShape="RoundRectangle 20" VerticalOptions="Center">
                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center"
                                           IsVisible="{Binding CanReadAloud}"
                                           AutomationProperties.IsInAccessibleTree="True"
                                           AutomationProperties.Name="{loc:Translate ReadAloud}">
                        <Label Text="&#128266;" FontSize="14" VerticalOptions="Center" />
                        <Switch IsToggled="{Binding ReadStepsAloud, Mode=TwoWay}" VerticalOptions="Center"
                                OnColor="{DynamicResource Lime}" ThumbColor="{DynamicResource BgElevated}"
                                Scale="0.8" />
                    </HorizontalStackLayout>
                    <BoxView WidthRequest="1" Color="{DynamicResource Line}" VerticalOptions="Fill"
                             IsVisible="{Binding CanReadAloud}" />
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="{loc:Translate ScreenOn}" TextColor="{DynamicResource Muted}" FontSize="12.5"
                               FontAttributes="Bold" VerticalOptions="Center" />
                        <Switch IsToggled="{Binding KeepScreenAwake, Mode=TwoWay}" VerticalOptions="Center"
                                OnColor="{DynamicResource Lime}" ThumbColor="{DynamicResource BgElevated}"
                                Scale="0.8" />
                    </HorizontalStackLayout>
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- Progress -->
        <ProgressBar Grid.Row="1" Progress="{Binding Progress}" ProgressColor="{DynamicResource Lime}"
                     BackgroundColor="{DynamicResource Line}" HeightRequest="4" />

        <!-- Title + step + ingredients toggle -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <VerticalStackLayout Spacing="3">
                <Label Text="{Binding Recipe.Title}" TextColor="{DynamicResource Ink}" FontSize="24"
                       FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="2" />
                <Label Text="{Binding StepLabel}" TextColor="{DynamicResource Muted}" FontSize="12"
                       CharacterSpacing="1.6" FontAttributes="Bold" />
            </VerticalStackLayout>
            <Border Grid.Column="1" BackgroundColor="{DynamicResource LimeWash}" Stroke="{DynamicResource LineSoft}"
                    StrokeThickness="1" Padding="13,9" MinimumHeightRequest="48" StrokeShape="RoundRectangle 12"
                    VerticalOptions="Center" IsVisible="{Binding HasIngredients}"
                    local:TapFeedback.IsEnabled="True" AutomationProperties.IsInAccessibleTree="True" AutomationProperties.Name="{loc:Translate ShowIngredients}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleIngredientsCommand}" />
                </Border.GestureRecognizers>
                <Label Text="{Binding IngredientsToggleLabel}" TextColor="{DynamicResource LimeBright}" FontSize="12.5"
                       FontAttributes="Bold" VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Step area (hidden while the ingredients panel is open): a swipeable carousel of step
             cards up top, with the fixed cooking controls (timers, read-aloud, voice) below so a
             running countdown never rotates out of reach. -->
        <Grid Grid.Row="3" RowDefinitions="*,Auto" RowSpacing="14"
              IsVisible="{Binding ShowIngredients, Converter={StaticResource InvertedBoolConverter}}">

            <!-- Rotate/swipe horizontally to move between steps. Replaces the old pan-drag card,
                 which felt laggy and dropped quick flicks on Android. Position is two-way bound so
                 the nav buttons and voice commands keep the carousel in sync. -->
            <CarouselView Grid.Row="0" ItemsSource="{Binding Steps}" Loop="False"
                          Position="{Binding CurrentStepIndex, Mode=TwoWay}"
                          PeekAreaInsets="12" HorizontalScrollBarVisibility="Never">
                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource LineSoft}"
                                StrokeThickness="1" Padding="24" StrokeShape="RoundRectangle 22"
                                Margin="4,0" VerticalOptions="Fill">
                            <ScrollView VerticalScrollBarVisibility="Never">
                                <Label Text="{Binding Instruction}" TextColor="{DynamicResource Ink}" FontSize="27"
                                       FontAttributes="Bold" LineHeight="1.18" VerticalOptions="Center" />
                            </ScrollView>
                        </Border>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>

            <ScrollView Grid.Row="1" VerticalScrollBarVisibility="Never" MaximumHeightRequest="240">
            <VerticalStackLayout Spacing="16">

                <!-- Active countdowns: several timers can run at once, each named and stoppable. -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasActiveTimers}"
                                     BindableLayout.ItemsSource="{Binding ActiveTimers}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{DynamicResource LimeWash}" Stroke="{DynamicResource Lime}"
                                    StrokeThickness="1" Padding="16,14" StrokeShape="RoundRectangle 16">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                    <VerticalStackLayout>
                                        <Label Text="{Binding Label}" TextColor="{DynamicResource LimeBright}"
                                               FontSize="12.5" CharacterSpacing="1.2" FontAttributes="Bold"
                                               LineBreakMode="TailTruncation" MaxLines="1" />
                                        <Label Text="{Binding Display}" TextColor="{DynamicResource Ink}"
                                               FontSize="34" FontAttributes="Bold" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" BackgroundColor="{DynamicResource Surface}"
                                            Stroke="{DynamicResource Line}" StrokeThickness="1" Padding="16,12"
                                            MinimumHeightRequest="48" StrokeShape="RoundRectangle 12" VerticalOptions="Center"
                                            local:TapFeedback.IsEnabled="True" AutomationProperties.IsInAccessibleTree="True" AutomationProperties.Name="{loc:Translate Stop}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding StopCommand}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{loc:Translate Stop}" TextColor="{DynamicResource Danger}" FontSize="13.5"
                                               FontAttributes="Bold" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Detected timer chips -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasStepTimers}">
                    <Label Text="{loc:Translate SectionTimers}" TextColor="{DynamicResource Muted}" FontSize="11"
                           CharacterSpacing="1.6" FontAttributes="Bold" />
                    <FlexLayout Wrap="Wrap" BindableLayout.ItemsSource="{Binding CurrentStepTimers}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Lime}"
                                        StrokeThickness="1" Padding="16,13" MinimumHeightRequest="48"
                                        StrokeShape="RoundRectangle 13" Margin="0,0,8,8" local:TapFeedback.IsEnabled="True"
                                        AutomationProperties.IsInAccessibleTree="True"
                                        AutomationProperties.Name="{Binding Label}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={x:Reference FocusRoot}, Path=BindingContext.StartTimerCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Label Text="&#9202;" FontSize="16" TextColor="{DynamicResource Lime}"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding Label}" TextColor="{DynamicResource Ink}"
                                               FontSize="14.5" FontAttributes="Bold" VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <Label Text="{loc:Translate FocusHint}"
                       TextColor="{DynamicResource Muted}" FontSize="13.5" />

                <!-- Replay the current step aloud, and toggle hands-free voice navigation. -->
                <HorizontalStackLayout Spacing="10">
                    <Border BackgroundColor="{DynamicResource BgElevated}" Stroke="{DynamicResource LineSoft}"
                            StrokeThickness="1" Padding="14,10" MinimumHeightRequest="44" StrokeShape="RoundRectangle 12"
                            local:TapFeedback.IsEnabled="True" IsVisible="{Binding CanReadAloud}"
                            AutomationProperties.IsInAccessibleTree="True" AutomationProperties.Name="{loc:Translate ReadStep}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ReadStepCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="&#128266;" FontSize="15" VerticalOptions="Center" />
                            <Label Text="{loc:Translate ReadStep}" TextColor="{DynamicResource Ink}" FontSize="13.5"
                                   FontAttributes="Bold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Mic toggle: only shown where speech recognition is available. Two overlaid
                         borders give a clear on/off state without a value converter. -->
                    <Grid IsVisible="{Binding IsVoiceSupported}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleVoiceCommand}" />
                        </Grid.GestureRecognizers>
                        <Border BackgroundColor="{DynamicResource BgElevated}" Stroke="{DynamicResource LineSoft}"
                                StrokeThickness="1" Padding="14,10" MinimumHeightRequest="44" StrokeShape="RoundRectangle 12"
                                local:TapFeedback.IsEnabled="True"
                                IsVisible="{Binding IsListening, Converter={StaticResource InvertedBoolConverter}}"
                                AutomationProperties.IsInAccessibleTree="True" AutomationProperties.Name="{loc:Translate VoiceControl}">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="&#127908;" FontSize="15" VerticalOptions="Center" />
                                <Label Text="{loc:Translate VoiceControl}" TextColor="{DynamicResource Ink}" FontSize="13.5"
                                       FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border BackgroundColor="{DynamicResource Lime}" Stroke="{DynamicResource Lime}"
                                StrokeThickness="1" Padding="14,10" MinimumHeightRequest="44" StrokeShape="RoundRectangle 12"
                                IsVisible="{Binding IsListening}">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Label Text="&#127908;" FontSize="15" VerticalOptions="Center" />
                                <Label Text="{loc:Translate VoiceListening}" TextColor="{DynamicResource LimeInk}" FontSize="13.5"
                                       FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                </HorizontalStackLayout>

                <!-- Tells the cook exactly what to say, with the words in the recipe's language. -->
                <Label Text="{Binding VoiceCommandsHint}" IsVisible="{Binding IsVoiceSupported}"
                       TextColor="{DynamicResource Muted}" FontSize="12.5" />
            </VerticalStackLayout>
          </ScrollView>
        </Grid>

        <!-- Ingredients panel -->
        <Border Grid.Row="3" BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource LineSoft}"
                StrokeThickness="1" Padding="8,4" StrokeShape="RoundRectangle 22" VerticalOptions="Fill"
                IsVisible="{Binding ShowIngredients}">
            <ScrollView>
                <VerticalStackLayout Padding="14,12" Spacing="0" BindableLayout.ItemsSource="{Binding Ingredients}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,4"
                                  MinimumHeightRequest="48"
                                  AutomationProperties.IsInAccessibleTree="True"
                                  AutomationProperties.Name="{Binding Text}">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnIngredientTapped" />
                                </Grid.GestureRecognizers>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          Color="{DynamicResource Lime}" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding Text}" TextColor="{DynamicResource Ink}"
                                       TextDecorations="{Binding TextDecoration}"
                                       Opacity="{Binding IsChecked, Converter={StaticResource CheckedOpacityConverter}}"
                                       FontSize="16" LineHeight="1.2" VerticalOptions="Center" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </ScrollView>
        </Border>

        <!-- Navigation -->
        <Grid Grid.Row="4" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Text="{loc:Translate Back}" Command="{Binding PreviousCommand}" BackgroundColor="{DynamicResource Surface}"
                    TextColor="{DynamicResource Muted}" FontAttributes="Bold" CornerRadius="16" HeightRequest="56" />
            <Button Grid.Column="1" Text="{Binding PrimaryActionLabel}" Command="{Binding AdvanceCommand}"
                    BackgroundColor="{DynamicResource Lime}" TextColor="{DynamicResource LimeInk}"
                    FontAttributes="Bold" FontSize="16" CornerRadius="16" HeightRequest="56" />
        </Grid>
    </Grid>
</ContentPage>
