<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PurePrep"
             xmlns:loc="clr-namespace:PurePrep.Localization"
             xmlns:controls="clr-namespace:PurePrep.Controls"
             xmlns:icons="clr-namespace:PurePrep.Resources.Styles"
             xmlns:domain="clr-namespace:PurePrep.Domain;assembly=PurePrep.Core"
             x:Class="PurePrep.MainPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource Bg}">

    <!-- Outer grid lets the upgrade sheet float above the content. -->
    <Grid>
        <Grid x:Name="ContentRoot" MaximumWidthRequest="760" HorizontalOptions="Center"
              Padding="20,12,20,0">

            <!-- The whole page is one scrolling list: the header, clipboard banner, search and filter
                 chips live in the CollectionView's Header so they scroll away with the recipes. This is
                 what makes browsing work in landscape, where fixed top rows would otherwise squeeze
                 the list to nothing. -->
            <CollectionView ItemsSource="{Binding Recipes}" SelectionMode="None"
                            VerticalScrollBarVisibility="Never">
                <CollectionView.Header>
                    <VerticalStackLayout Spacing="20" Padding="0,0,0,4">

            <!-- ===== Header ===== -->
            <VerticalStackLayout Spacing="14">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label Text="PUREPREP" TextColor="{DynamicResource Lime}" FontSize="12"
                           CharacterSpacing="3.4" FontAttributes="Bold" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                        <Border BackgroundColor="{DynamicResource LimeWash}"
                                Stroke="{DynamicResource LineSoft}" StrokeThickness="1"
                                Padding="12,9" MinimumHeightRequest="48" StrokeShape="RoundRectangle 20"
                                local:TapFeedback.IsEnabled="True" AutomationProperties.IsInAccessibleTree="True" AutomationProperties.Name="{loc:Translate SmartCredits}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding UpgradeCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Ellipse Fill="{DynamicResource Lime}" WidthRequest="7" HeightRequest="7"
                                         VerticalOptions="Center" />
                                <Label Text="{Binding QuotaSummary}" TextColor="{DynamicResource LimeBright}"
                                       FontSize="12.5" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Surface}"
                                Stroke="{DynamicResource Line}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 24" VerticalOptions="Center"
                                local:TapFeedback.IsEnabled="True" AutomationProperties.IsInAccessibleTree="True" AutomationProperties.Name="{loc:Translate Settings}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSettingsTapped" />
                            </Border.GestureRecognizers>
                            <Label Style="{StaticResource IconLabel}" Text="{x:Static icons:Icons.Settings}"
                                   TextColor="{DynamicResource Muted}" FontSize="19" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>
            </VerticalStackLayout>

            <!-- ===== Clipboard banner, errors and the library search (scroll with the page) ===== -->
            <VerticalStackLayout Spacing="14">
                <!-- Clipboard chip: offers a recipe link found on the clipboard on resume/return to
                     Home. Tapping it opens the same Import sheet used for shares; the ✕ dismisses it
                     for that one link without importing (it won't be offered again until a different
                     link is copied). -->
                <Border IsVisible="{Binding HasClipboardSuggestion}" BackgroundColor="{DynamicResource LimeWash}"
                        Stroke="{DynamicResource LineSoft}" StrokeShape="RoundRectangle 16" Padding="14,10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Label Style="{StaticResource IconLabel}" Text="{x:Static icons:Icons.Link}" FontSize="20" />
                        <Label Grid.Column="1" VerticalOptions="Center" LineBreakMode="MiddleTruncation"
                               TextColor="{DynamicResource Ink}" FontSize="13.5"
                               Text="{Binding ClipboardSuggestionText}" />
                        <Label Grid.Column="2" Style="{StaticResource IconLabel}" Text="{x:Static icons:Icons.Close}" FontSize="20"
                               TextColor="{DynamicResource Muted}"
                               AutomationProperties.IsInAccessibleTree="True" AutomationProperties.Name="{loc:Translate Dismiss}">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DismissClipboardSuggestionCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnClipboardChipTapped" />
                    </Border.GestureRecognizers>
                </Border>

                <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource Danger}" FontSize="13"
                       Margin="4,0,0,0"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullOrEmptyConverter}}" />

                <!-- Search -->
                <Border BackgroundColor="{DynamicResource Surface}"
                        Stroke="{DynamicResource LineSoft}" StrokeThickness="1"
                        Padding="14,2" StrokeShape="RoundRectangle 13"
                        IsVisible="{Binding HasRecipes}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                        <Label Style="{StaticResource IconLabel}" Text="{x:Static icons:Icons.Search}" FontSize="18"
                               TextColor="{DynamicResource Muted}" />
                        <Entry Grid.Column="1" Text="{Binding SearchText}" Placeholder="{loc:Translate SearchPlaceholder}"
                               PlaceholderColor="{DynamicResource Muted}" TextColor="{DynamicResource Ink}"
                               BackgroundColor="Transparent" ReturnType="Search"
                               ClearButtonVisibility="WhileEditing" />
                    </Grid>
                </Border>

                <!-- Filter chips (All / Want to cook / Cooked / Favourites) + sort button. A wrapping row
                     rather than a horizontal ScrollView beside the sort button: inside the list header
                     the ScrollView clipped the last chip (unreachable with long sort labels / languages).
                     Wrapping keeps every chip and the sort button on screen at any width. The negative
                     bottom margin cancels the last line's 8px chip gap. -->
                <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center" AlignContent="Start"
                            Margin="0,0,0,-8" IsVisible="{Binding HasRecipes}">
                    <Border Margin="0,0,8,8" Padding="14,9" StrokeThickness="1" StrokeShape="RoundRectangle 13"
                            BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            local:TapFeedback.IsEnabled="True">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectFilterCommand}"
                                                   CommandParameter="{x:Static domain:LibraryFilter.All}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Filter}" Value="{x:Static domain:LibraryFilter.All}">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Lime}" />
                                <Setter Property="Stroke" Value="{DynamicResource Lime}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{loc:Translate FilterAll}" FontSize="13" FontAttributes="Bold"
                               TextColor="{DynamicResource Muted}" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Filter}" Value="{x:Static domain:LibraryFilter.All}">
                                    <Setter Property="TextColor" Value="{DynamicResource LimeInk}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                    <Border Margin="0,0,8,8" Padding="14,9" StrokeThickness="1" StrokeShape="RoundRectangle 13"
                            BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            local:TapFeedback.IsEnabled="True">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectFilterCommand}"
                                                   CommandParameter="{x:Static domain:LibraryFilter.WantToCook}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Filter}" Value="{x:Static domain:LibraryFilter.WantToCook}">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Lime}" />
                                <Setter Property="Stroke" Value="{DynamicResource Lime}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{loc:Translate FilterWantToCook}" FontSize="13" FontAttributes="Bold"
                               TextColor="{DynamicResource Muted}" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Filter}" Value="{x:Static domain:LibraryFilter.WantToCook}">
                                    <Setter Property="TextColor" Value="{DynamicResource LimeInk}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                    <Border Margin="0,0,8,8" Padding="14,9" StrokeThickness="1" StrokeShape="RoundRectangle 13"
                            BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            local:TapFeedback.IsEnabled="True">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectFilterCommand}"
                                                   CommandParameter="{x:Static domain:LibraryFilter.Cooked}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Filter}" Value="{x:Static domain:LibraryFilter.Cooked}">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Lime}" />
                                <Setter Property="Stroke" Value="{DynamicResource Lime}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{loc:Translate FilterCooked}" FontSize="13" FontAttributes="Bold"
                               TextColor="{DynamicResource Muted}" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Filter}" Value="{x:Static domain:LibraryFilter.Cooked}">
                                    <Setter Property="TextColor" Value="{DynamicResource LimeInk}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>

                    <Border Margin="0,0,8,8" Padding="14,9" StrokeThickness="1" StrokeShape="RoundRectangle 13"
                            BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            local:TapFeedback.IsEnabled="True">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectFilterCommand}"
                                                   CommandParameter="{x:Static domain:LibraryFilter.Favourites}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Filter}" Value="{x:Static domain:LibraryFilter.Favourites}">
                                <Setter Property="BackgroundColor" Value="{DynamicResource Lime}" />
                                <Setter Property="Stroke" Value="{DynamicResource Lime}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Label Text="{loc:Translate FilterFavourites}" FontSize="13" FontAttributes="Bold"
                               TextColor="{DynamicResource Muted}" VerticalOptions="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding Filter}" Value="{x:Static domain:LibraryFilter.Favourites}">
                                    <Setter Property="TextColor" Value="{DynamicResource LimeInk}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </Border>


                    <Border Margin="0,0,0,8" Padding="10,9" StrokeThickness="1" StrokeShape="RoundRectangle 13"
                            BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            local:TapFeedback.IsEnabled="True" AutomationProperties.IsInAccessibleTree="True"
                            AutomationProperties.Name="{loc:Translate SortBy}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ChooseSortCommand}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label Style="{StaticResource IconLabel}" Text="{x:Static icons:Icons.Tune}" FontSize="16"
                                   TextColor="{DynamicResource Muted}" />
                            <Label Text="{Binding SortLabel}" TextColor="{DynamicResource Muted}" FontSize="13"
                                   FontAttributes="Bold" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </FlexLayout>
                </VerticalStackLayout>

                    </VerticalStackLayout>
                </CollectionView.Header>

                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="0" BackgroundColor="{DynamicResource Surface}"
                                    Stroke="{DynamicResource Line}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 20">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenDetailCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid Padding="16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"
                                      RowDefinitions="Auto,Auto" RowSpacing="6">
                                    <Grid Grid.RowSpan="2" WidthRequest="64" HeightRequest="64" VerticalOptions="Center">
                                        <!-- Placeholder tile: shown until/unless a photo loads. -->
                                        <Border BackgroundColor="{DynamicResource LimeWash}"
                                                Stroke="{DynamicResource LineSoft}" StrokeThickness="1"
                                                StrokeShape="RoundRectangle 16">
                                            <Label Text="{Binding Title, Converter={StaticResource FirstLetterConverter}}"
                                                   TextColor="{DynamicResource Lime}" FontSize="24" FontAttributes="Bold"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <Image Source="{Binding ., Converter={StaticResource RecipeImage}}"
                                               Aspect="AspectFill" WidthRequest="64" HeightRequest="64">
                                            <Image.Clip>
                                                <RoundRectangleGeometry CornerRadius="16" Rect="0,0,64,64" />
                                            </Image.Clip>
                                        </Image>
                                    </Grid>

                                    <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6" VerticalOptions="Center">
                                        <Label Text="{Binding Title}" TextColor="{DynamicResource Ink}"
                                               FontSize="17" FontAttributes="Bold" LineBreakMode="TailTruncation"
                                               MaxLines="2" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Style="{StaticResource IconLabel}" Text="{x:Static icons:Icons.Favourite}"
                                               FontSize="15" TextColor="{DynamicResource Lime}"
                                               IsVisible="{Binding IsFavourite}" VerticalOptions="Start" />
                                    </Grid>

                                    <Label Grid.Column="1" Grid.Row="1" Text="{Binding ., Converter={StaticResource RecipeCardMeta}}"
                                           TextColor="{DynamicResource Muted}" FontSize="13" />

                                    <Border Grid.Column="2" Grid.RowSpan="2" BackgroundColor="{DynamicResource LimeWash}"
                                            StrokeThickness="0" Padding="13,10" MinimumHeightRequest="48"
                                            StrokeShape="RoundRectangle 12" VerticalOptions="Center" local:TapFeedback.IsEnabled="True"
                                            AutomationProperties.IsInAccessibleTree="True"
                                            AutomationProperties.Name="{loc:Translate Cook}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenFocusCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                            <Label Text="{loc:Translate Cook}" TextColor="{DynamicResource LimeBright}" FontSize="11.5"
                                                   FontAttributes="Bold" VerticalOptions="Center" />
                                            <Label Text="&#8250;" TextColor="{DynamicResource LimeBright}" FontSize="11.5"
                                                   FontAttributes="Bold" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- Empty states live in the Footer, not EmptyView: when the list empties, MAUI Android
                         swaps the RecyclerView to a separate empty-view adapter, which rebuilds the Header
                         and throws keyboard focus out of the search box (into the URL Entry). The footer
                         stays in the same adapter, so each state just toggles its own visibility. -->
                    <CollectionView.Footer>
                        <VerticalStackLayout Spacing="0">
                        <Grid>
                            <!-- No recipes at all: the Add button lives here instead of floating. -->
                            <VerticalStackLayout Spacing="14" VerticalOptions="Start" HorizontalOptions="Center" Margin="24,40"
                                                 IsVisible="{Binding HasRecipes, Converter={StaticResource InvertedBoolConverter}}">
                                <Border WidthRequest="72" HeightRequest="72" HorizontalOptions="Center"
                                        BackgroundColor="{DynamicResource LimeWash}" Stroke="{DynamicResource LineSoft}"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 22">
                                    <Label Style="{StaticResource IconLabel}" Text="{x:Static icons:Icons.Add}"
                                           TextColor="{DynamicResource Lime}" FontSize="36" />
                                </Border>
                                <Label Text="{loc:Translate AddYourFirstRecipe}" TextColor="{DynamicResource Ink}" FontSize="17"
                                       FontAttributes="Bold" HorizontalOptions="Center" HorizontalTextAlignment="Center" />
                                <Label Text="{loc:Translate AddFirstRecipeBody}"
                                       TextColor="{DynamicResource Muted}" FontSize="14" HorizontalTextAlignment="Center"
                                       HorizontalOptions="Center" MaximumWidthRequest="280" />
                                <controls:AddRecipeButton HorizontalOptions="Center" Margin="0,6,0,0"
                                                          Tapped="OnAddRecipeTapped" />
                            </VerticalStackLayout>

                            <!-- Search returned nothing -->
                            <VerticalStackLayout Spacing="10" VerticalOptions="Start" HorizontalOptions="Center" Margin="24,40"
                                                 IsVisible="{Binding NoSearchMatches}">
                                <Border WidthRequest="72" HeightRequest="72" HorizontalOptions="Center"
                                        BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource LineSoft}"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 22">
                                    <Label Style="{StaticResource IconLabel}" Text="{x:Static icons:Icons.Search}"
                                           TextColor="{DynamicResource Muted}" FontSize="30" />
                                </Border>
                                <Label Text="{loc:Translate NoMatchesTitle}" TextColor="{DynamicResource Ink}" FontSize="17"
                                       FontAttributes="Bold" HorizontalOptions="Center" />
                                <Label Text="{Binding SearchText, Converter={StaticResource ResourceFormatConverter}, ConverterParameter=NoMatchesBodyFormat}"
                                       TextColor="{DynamicResource Muted}" FontSize="14" HorizontalTextAlignment="Center"
                                       HorizontalOptions="Center" MaximumWidthRequest="280" />
                            </VerticalStackLayout>

                            <!-- Filter chip narrowed the library to nothing (no search text active) -->
                            <VerticalStackLayout Spacing="10" VerticalOptions="Start" HorizontalOptions="Center" Margin="24,40"
                                                 IsVisible="{Binding NoFilterMatches}">
                                <Border WidthRequest="72" HeightRequest="72" HorizontalOptions="Center"
                                        BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource LineSoft}"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 22">
                                    <Label Style="{StaticResource IconLabel}" Text="{x:Static icons:Icons.Tune}"
                                           TextColor="{DynamicResource Muted}" FontSize="30" />
                                </Border>
                                <Label Text="{loc:Translate NoFilterMatchesTitle}" TextColor="{DynamicResource Ink}" FontSize="17"
                                       FontAttributes="Bold" HorizontalOptions="Center" />
                                <Label Text="{loc:Translate NoFilterMatchesBody}"
                                       TextColor="{DynamicResource Muted}" FontSize="14" HorizontalTextAlignment="Center"
                                       HorizontalOptions="Center" MaximumWidthRequest="280" />
                                <Border BackgroundColor="{DynamicResource LimeWash}" Stroke="{DynamicResource LineSoft}"
                                        StrokeThickness="1" Padding="16,10" StrokeShape="RoundRectangle 13"
                                        HorizontalOptions="Center" Margin="0,4,0,0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectFilterCommand}"
                                                               CommandParameter="{x:Static domain:LibraryFilter.All}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{loc:Translate ShowAllFilter}" TextColor="{DynamicResource LimeBright}"
                                           FontSize="14" FontAttributes="Bold" />
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                        <!-- Keeps the last card scrollable out from under the floating Add button / timers bar;
                             sized in code to the bottom dock's height. -->
                        <BoxView x:Name="BottomDockSpacer" HeightRequest="96" Color="Transparent" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>
        </Grid>

        <!-- Bottom dock: the floating "+ Add recipe" button sits above the app-wide running-timers
             bar, both under the sheets' scrim. The dock itself lets taps through to the list; only its
             children take them. Width is stamped in code (see OnPageSizeChanged). -->
        <VerticalStackLayout x:Name="BottomDock" VerticalOptions="End" HorizontalOptions="Center"
                             Padding="20,0,20,6" Spacing="4"
                             InputTransparent="True" CascadeInputTransparent="False">
            <controls:AddRecipeButton x:Name="AddButton" HorizontalOptions="End" Margin="0,0,0,10"
                                      IsVisible="{Binding HasRecipes}" Tapped="OnAddRecipeTapped" />
            <controls:TimersBar x:Name="TimersBarControl" />
        </VerticalStackLayout>

        <!-- Add sheet: every way to add a recipe, opened from the Add button. -->
        <controls:AddRecipeSheet x:Name="AddSheet"
                                  ImportLinkRequested="OnAddSheetImportLink"
                                  PasteRequested="OnPasteTapped"
                                  ClipboardSuggestionRequested="OnAddSheetClipboardSuggestion"
                                  WebSearchRequested="OnAddSheetWebSearch"
                                  PhotoRequested="OnAddSheetPhoto"
                                  TextRequested="OnAddSheetText"
                                  ManualRequested="OnAddSheetManual" />

        <!-- Import sheet: last child of the outer grid so it overlays everything on Home, for a
             share from another app, the clipboard banner or the Add sheet's link box. -->
        <controls:ImportSheet x:Name="ImportSheet"
                               ImportTapped="OnImportSheetImport"
                               BuyCreditsTapped="OnImportSheetBuyCredits"
                               OpenExistingTapped="OnImportSheetOpenExisting"
                               CancelTapped="OnImportSheetCancel" />
    </Grid>
</ContentPage>
