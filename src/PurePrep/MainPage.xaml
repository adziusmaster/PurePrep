<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PurePrep.Localization"
             x:Class="PurePrep.MainPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource Bg}">

    <!-- Outer grid lets the upgrade sheet float above the content. -->
    <Grid>
        <Grid MaximumWidthRequest="760" HorizontalOptions="Center"
              Padding="20,12,20,0" RowSpacing="20" RowDefinitions="Auto,Auto,*">

            <!-- ===== Header ===== -->
            <VerticalStackLayout Spacing="14">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <Label Text="PUREPREP" TextColor="{DynamicResource Lime}" FontSize="12"
                           CharacterSpacing="3.4" FontAttributes="Bold" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                        <Border BackgroundColor="{DynamicResource LimeWash}"
                                Stroke="{DynamicResource LineSoft}" StrokeThickness="1"
                                Padding="12,7" StrokeShape="RoundRectangle 20">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding UpgradeCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Ellipse Fill="{DynamicResource Lime}" WidthRequest="7" HeightRequest="7"
                                         VerticalOptions="Center" />
                                <Label Text="{Binding QuotaSummary}" TextColor="{DynamicResource LimeBright}"
                                       FontSize="12.5" FontAttributes="Bold" VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                        <Border WidthRequest="40" HeightRequest="40" BackgroundColor="{DynamicResource Surface}"
                                Stroke="{DynamicResource Line}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 20" VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSettingsTapped" />
                            </Border.GestureRecognizers>
                            <Label Text="&#9881;" TextColor="{DynamicResource Muted}" FontSize="19"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <VerticalStackLayout Spacing="0">
                    <Label Text="{loc:Translate AppTaglineLine1}" TextColor="{DynamicResource Ink}" FontSize="32"
                           FontAttributes="Bold" LineHeight="1.05" />
                    <Label Text="{loc:Translate AppTaglineLine2}" TextColor="{DynamicResource Lime}" FontSize="32"
                           FontAttributes="Bold" LineHeight="1.05" />
                </VerticalStackLayout>

                <Label Text="{loc:Translate AppSubtitle}"
                       TextColor="{DynamicResource Muted}" FontSize="14.5" LineHeight="1.25" />
            </VerticalStackLayout>

            <!-- ===== Import ===== -->
            <VerticalStackLayout Grid.Row="1" Spacing="9">
                <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                        StrokeThickness="1" Padding="7" StrokeShape="RoundRectangle 20">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="7">
                        <Entry Text="{Binding UrlInput}" Placeholder="{loc:Translate PasteUrlPlaceholder}"
                               Margin="10,0,0,0" TextColor="{DynamicResource Ink}"
                               PlaceholderColor="{DynamicResource Faint}" Keyboard="Url"
                               ClearButtonVisibility="WhileEditing" VerticalOptions="Center"
                               ReturnCommand="{Binding ImportCommand}" />

                        <Button Grid.Column="1" Text="{loc:Translate Import}" Command="{Binding ImportCommand}"
                                IsVisible="{Binding IsImporting, Converter={StaticResource InvertedBoolConverter}}"
                                BackgroundColor="{DynamicResource Lime}" TextColor="{DynamicResource LimeInk}"
                                FontAttributes="Bold" FontSize="15" Padding="22,12" CornerRadius="14" />

                        <Border Grid.Column="1" IsVisible="{Binding IsImporting}"
                                BackgroundColor="{DynamicResource LimeWash}" StrokeThickness="0"
                                Padding="22,10" StrokeShape="RoundRectangle 14">
                            <ActivityIndicator IsRunning="{Binding IsImporting}"
                                               Color="{DynamicResource Lime}"
                                               WidthRequest="22" HeightRequest="22" />
                        </Border>
                    </Grid>
                </Border>

                <Label Text="{Binding ErrorMessage}" TextColor="{DynamicResource Danger}" FontSize="13"
                       Margin="4,0,0,0"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotNullOrEmptyConverter}}" />

                <!-- One-time tip: recipes auto-translate into the chosen recipe language. -->
                <Border IsVisible="{Binding IsRecipeLanguageHintVisible}" BackgroundColor="{DynamicResource BgElevated}"
                        Stroke="{DynamicResource LineSoft}" StrokeThickness="1" Padding="14,12"
                        StrokeShape="RoundRectangle 16" Margin="0,4,0,0">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{loc:Translate RecipeLangHintTitle}" TextColor="{DynamicResource Ink}"
                                   FontSize="14" FontAttributes="Bold" />
                            <Label Text="{loc:Translate RecipeLangHintBody}" TextColor="{DynamicResource Muted}"
                                   FontSize="12.5" LineHeight="1.25" />
                            <Label Text="{loc:Translate RecipeLangHintAction}" TextColor="{DynamicResource LimeBright}"
                                   FontSize="13" FontAttributes="Bold" Margin="0,2,0,0">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding OpenRecipeLanguageSettingsCommand}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                        <Border Grid.Column="1" WidthRequest="28" HeightRequest="28"
                                BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                                StrokeThickness="1" StrokeShape="RoundRectangle 14"
                                VerticalOptions="Start" HorizontalOptions="End">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DismissRecipeLanguageHintCommand}" />
                            </Border.GestureRecognizers>
                            <Label Text="&#10005;" TextColor="{DynamicResource Muted}" FontSize="12"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- ===== Library ===== -->
            <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*" RowSpacing="14">
                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{loc:Translate YourRecipes}" TextColor="{DynamicResource Ink}" FontSize="20"
                               FontAttributes="Bold" />
                        <Label Text="{loc:Translate YourRecipesSubtitle}" TextColor="{DynamicResource Muted}"
                               FontSize="13" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" BackgroundColor="{DynamicResource LimeWash}"
                            Stroke="{DynamicResource LineSoft}" StrokeThickness="1"
                            Padding="13,8" StrokeShape="RoundRectangle 13" VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddManuallyCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{loc:Translate AddManually}" TextColor="{DynamicResource LimeBright}" FontSize="13.5"
                               FontAttributes="Bold" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Search -->
                <Border Grid.Row="1" BackgroundColor="{DynamicResource Surface}"
                        Stroke="{DynamicResource LineSoft}" StrokeThickness="1"
                        Padding="14,2" StrokeShape="RoundRectangle 13"
                        IsVisible="{Binding HasRecipes}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                        <Label Text="⌕" FontSize="18" TextColor="{DynamicResource Muted}"
                               VerticalOptions="Center" />
                        <Entry Grid.Column="1" Text="{Binding SearchText}" Placeholder="{loc:Translate SearchPlaceholder}"
                               PlaceholderColor="{DynamicResource Muted}" TextColor="{DynamicResource Ink}"
                               BackgroundColor="Transparent" ReturnType="Search"
                               ClearButtonVisibility="WhileEditing" />
                    </Grid>
                </Border>

                <CollectionView Grid.Row="2" ItemsSource="{Binding Recipes}" SelectionMode="None"
                                VerticalScrollBarVisibility="Never">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12" Padding="0" BackgroundColor="{DynamicResource Surface}"
                                    Stroke="{DynamicResource Line}" StrokeThickness="1"
                                    StrokeShape="RoundRectangle 20">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenDetailCommand}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <Grid Padding="16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"
                                      RowDefinitions="Auto,Auto" RowSpacing="6">
                                    <Border Grid.RowSpan="2" WidthRequest="48" HeightRequest="48"
                                            BackgroundColor="{DynamicResource LimeWash}"
                                            Stroke="{DynamicResource LineSoft}" StrokeThickness="1"
                                            StrokeShape="RoundRectangle 15" VerticalOptions="Center">
                                        <Label Text="{Binding StepCount}" TextColor="{DynamicResource Lime}"
                                               FontSize="19" FontAttributes="Bold"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>

                                    <Label Grid.Column="1" Text="{Binding Title}" TextColor="{DynamicResource Ink}"
                                           FontSize="17" FontAttributes="Bold" LineBreakMode="TailTruncation"
                                           MaxLines="2" VerticalOptions="Center" />

                                    <HorizontalStackLayout Grid.Column="1" Grid.Row="1" Spacing="7">
                                        <Label Text="{Binding StepCount, Converter={StaticResource ResourceFormatConverter}, ConverterParameter=StepsCountFormat}"
                                               TextColor="{DynamicResource Muted}" FontSize="13" />
                                        <Label Text="&#183;" TextColor="{DynamicResource Faint}" FontSize="13" />
                                        <Label Text="{Binding IngredientCount, Converter={StaticResource ResourceFormatConverter}, ConverterParameter=IngredientsCountFormat}"
                                               TextColor="{DynamicResource Muted}" FontSize="13" />
                                    </HorizontalStackLayout>

                                    <Border Grid.Column="2" Grid.RowSpan="2" BackgroundColor="{DynamicResource LimeWash}"
                                            StrokeThickness="0" Padding="13,8" StrokeShape="RoundRectangle 12"
                                            VerticalOptions="Center">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenFocusCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                            <Label Text="{loc:Translate Cook}" TextColor="{DynamicResource LimeBright}" FontSize="11.5"
                                                   FontAttributes="Bold" VerticalOptions="Center" />
                                            <Label Text="&#8250;" TextColor="{DynamicResource LimeBright}" FontSize="11.5"
                                                   FontAttributes="Bold" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <Grid Padding="24,40">
                            <!-- No recipes at all -->
                            <VerticalStackLayout Spacing="14" VerticalOptions="Start" HorizontalOptions="Center"
                                                 IsVisible="{Binding IsSearching, Converter={StaticResource InvertedBoolConverter}}">
                                <Border WidthRequest="72" HeightRequest="72" HorizontalOptions="Center"
                                        BackgroundColor="{DynamicResource LimeWash}" Stroke="{DynamicResource LineSoft}"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 22">
                                    <Label Text="+" TextColor="{DynamicResource Lime}" FontSize="34"
                                           FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="{loc:Translate NoRecipesTitle}" TextColor="{DynamicResource Ink}" FontSize="17"
                                       FontAttributes="Bold" HorizontalOptions="Center" />
                                <Label Text="{loc:Translate NoRecipesBody}"
                                       TextColor="{DynamicResource Muted}" FontSize="14" HorizontalTextAlignment="Center"
                                       HorizontalOptions="Center" MaximumWidthRequest="280" />
                                <Border BackgroundColor="{DynamicResource LimeWash}" Stroke="{DynamicResource LineSoft}"
                                        StrokeThickness="1" Padding="16,10" StrokeShape="RoundRectangle 13"
                                        HorizontalOptions="Center" Margin="0,4,0,0">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding AddManuallyCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label Text="{loc:Translate AddOneManually}" TextColor="{DynamicResource LimeBright}"
                                           FontSize="14" FontAttributes="Bold" />
                                </Border>
                            </VerticalStackLayout>

                            <!-- Search returned nothing -->
                            <VerticalStackLayout Spacing="10" VerticalOptions="Start" HorizontalOptions="Center"
                                                 IsVisible="{Binding IsSearching}">
                                <Border WidthRequest="72" HeightRequest="72" HorizontalOptions="Center"
                                        BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource LineSoft}"
                                        StrokeThickness="1" StrokeShape="RoundRectangle 22">
                                    <Label Text="&#8981;" TextColor="{DynamicResource Muted}" FontSize="30"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <Label Text="{loc:Translate NoMatchesTitle}" TextColor="{DynamicResource Ink}" FontSize="17"
                                       FontAttributes="Bold" HorizontalOptions="Center" />
                                <Label Text="{Binding SearchText, Converter={StaticResource ResourceFormatConverter}, ConverterParameter=NoMatchesBodyFormat}"
                                       TextColor="{DynamicResource Muted}" FontSize="14" HorizontalTextAlignment="Center"
                                       HorizontalOptions="Center" MaximumWidthRequest="280" />
                            </VerticalStackLayout>
                        </Grid>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>
        </Grid>

        <!-- ===== Upgrade sheet (floats above content) ===== -->
        <!-- Dim scrim: tap outside the sheet to dismiss. -->
        <BoxView Color="#B3000000" IsVisible="{Binding IsUpgradePromptVisible}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding DismissUpgradeCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource LimeDim}"
                StrokeThickness="1" Padding="18" Margin="14,0,14,18" StrokeShape="RoundRectangle 22"
                VerticalOptions="End" MaximumWidthRequest="720" HorizontalOptions="Center"
                IsVisible="{Binding IsUpgradePromptVisible}">
            <VerticalStackLayout Spacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{loc:Translate OutOfCreditsTitle}" TextColor="{DynamicResource Ink}" FontSize="17"
                               FontAttributes="Bold" />
                        <Label Text="{loc:Translate OutOfCreditsBody}"
                               TextColor="{DynamicResource Muted}" FontSize="13.5" LineHeight="1.25" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" WidthRequest="32" HeightRequest="32"
                            BackgroundColor="{DynamicResource BgElevated}" Stroke="{DynamicResource Line}"
                            StrokeThickness="1" StrokeShape="RoundRectangle 16"
                            VerticalOptions="Start" HorizontalOptions="End">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DismissUpgradeCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="&#10005;" TextColor="{DynamicResource Muted}" FontSize="14"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <!-- Why credits cost money -->
                <Border BackgroundColor="{DynamicResource BgElevated}" Stroke="Transparent" Padding="12"
                        StrokeShape="RoundRectangle 14">
                    <VerticalStackLayout Spacing="3">
                        <Label Text="{loc:Translate WhyCreditsTitle}" TextColor="{DynamicResource Ink}"
                               FontSize="13.5" FontAttributes="Bold" />
                        <Label Text="{loc:Translate WhyCreditsBody}" TextColor="{DynamicResource Muted}"
                               FontSize="12.5" LineHeight="1.25" />
                    </VerticalStackLayout>
                </Border>

                <!-- Pack picker: one button per pack (hidden where billing is unavailable) -->
                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding CreditPacks}"
                                     IsVisible="{Binding IsBillingSupported}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Button Text="{Binding Label}"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.BuyPackCommand}"
                                    CommandParameter="{Binding .}"
                                    BackgroundColor="{DynamicResource Lime}" TextColor="{DynamicResource LimeInk}"
                                    FontAttributes="Bold" FontSize="15" HeightRequest="50" CornerRadius="15" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <!-- Fallback for platforms without in-app billing (iOS/web preview) -->
                <Button Text="{loc:Translate TopUpCredits}" Command="{Binding TopUpCommand}"
                        IsVisible="{Binding IsBillingSupported, Converter={StaticResource InvertedBoolConverter}}"
                        BackgroundColor="{DynamicResource Lime}" TextColor="{DynamicResource LimeInk}"
                        FontAttributes="Bold" FontSize="15" HeightRequest="50" CornerRadius="15" />

                <ActivityIndicator IsRunning="{Binding IsPurchasing}" IsVisible="{Binding IsPurchasing}"
                                   Color="{DynamicResource Lime}" HeightRequest="24" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
