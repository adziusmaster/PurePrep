<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PurePrep"
             xmlns:loc="clr-namespace:PurePrep.Localization"
             x:Class="PurePrep.ManualAddPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource Bg}">

    <Grid MaximumWidthRequest="760" HorizontalOptions="Center"
          RowDefinitions="Auto,*,Auto" Padding="20,12,20,16" RowSpacing="18">

        <!-- Header -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
            <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Surface}"
                    Stroke="{DynamicResource Line}" StrokeThickness="1" StrokeShape="RoundRectangle 14"
                    local:TapFeedback.IsEnabled="True" AutomationProperties.IsInAccessibleTree="True" AutomationProperties.Name="{loc:Translate Cancel}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCancelTapped" />
                </Border.GestureRecognizers>
                <Label Text="&#8249;" TextColor="{DynamicResource Ink}" FontSize="26"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="1">
                <Label x:Name="HeaderTitle" Text="{loc:Translate AddRecipeTitle}" TextColor="{DynamicResource Ink}" FontSize="20" FontAttributes="Bold" />
                <Label x:Name="HeaderSubtitle" Text="{loc:Translate AddRecipeSubtitle}" TextColor="{DynamicResource Muted}" FontSize="13" />
            </VerticalStackLayout>
        </Grid>

        <!-- Form -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="16">
                <VerticalStackLayout Spacing="7">
                    <Label Text="{loc:Translate FieldTitle}" TextColor="{DynamicResource Muted}" FontSize="11.5"
                           CharacterSpacing="1.6" FontAttributes="Bold" />
                    <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            StrokeThickness="1" Padding="14,2" StrokeShape="RoundRectangle 15">
                        <Entry x:Name="TitleEntry" Placeholder="{loc:Translate TitlePlaceholder}"
                               TextColor="{DynamicResource Ink}" PlaceholderColor="{DynamicResource Faint}" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="7">
                    <Label Text="{loc:Translate SectionIngredients}" TextColor="{DynamicResource Muted}" FontSize="11.5"
                           CharacterSpacing="1.6" FontAttributes="Bold" />
                    <Label Text="{loc:Translate OnePerLine}" TextColor="{DynamicResource Faint}" FontSize="12.5" />
                    <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            StrokeThickness="1" Padding="12,6" StrokeShape="RoundRectangle 15">
                        <Editor x:Name="IngredientsEditor" AutoSize="TextChanges" HeightRequest="150"
                                Placeholder="{loc:Translate IngredientsPlaceholder}"
                                TextColor="{DynamicResource Ink}" PlaceholderColor="{DynamicResource Faint}" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="7">
                    <Label Text="{loc:Translate SectionMethod}" TextColor="{DynamicResource Muted}" FontSize="11.5"
                           CharacterSpacing="1.6" FontAttributes="Bold" />
                    <Label Text="{loc:Translate OneStepPerLine}" TextColor="{DynamicResource Faint}" FontSize="12.5" />
                    <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            StrokeThickness="1" Padding="12,6" StrokeShape="RoundRectangle 15">
                        <Editor x:Name="StepsEditor" AutoSize="TextChanges" HeightRequest="200"
                                Placeholder="{loc:Translate StepsPlaceholder}"
                                TextColor="{DynamicResource Ink}" PlaceholderColor="{DynamicResource Faint}" />
                    </Border>
                </VerticalStackLayout>

                <Label x:Name="ErrorLabel" TextColor="{DynamicResource Danger}" FontSize="13" IsVisible="False" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Save -->
        <Button Grid.Row="2" x:Name="SaveButton" Text="{loc:Translate SaveRecipe}" Clicked="OnSaveClicked"
                BackgroundColor="{DynamicResource Lime}" TextColor="{DynamicResource LimeInk}"
                FontAttributes="Bold" FontSize="16" HeightRequest="54" CornerRadius="16" />
    </Grid>
</ContentPage>
