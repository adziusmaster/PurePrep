<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PurePrep"
             xmlns:loc="clr-namespace:PurePrep.Localization"
             xmlns:controls="clr-namespace:PurePrep.Controls"
             x:Class="PurePrep.PasteTextPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource Bg}">

    <Grid MaximumWidthRequest="760" HorizontalOptions="Center"
          RowDefinitions="Auto,*,Auto">

        <!-- Header -->
        <controls:TopBar Title="{loc:Translate ImportTextTitle}" Subtitle="{loc:Translate ImportTextBody}"
                          BackTapped="OnCancelTapped" />

        <!-- Text -->
        <Border Grid.Row="1" Margin="20,10,20,0" BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                StrokeThickness="1" Padding="12,6" StrokeShape="RoundRectangle 15">
            <ScrollView>
                <Editor x:Name="TextEditor" AutoSize="TextChanges" MinimumHeightRequest="260"
                        Placeholder="{loc:Translate ImportTextPlaceholder}"
                        TextColor="{DynamicResource Ink}" PlaceholderColor="{DynamicResource Faint}" />
            </ScrollView>
        </Border>

        <VerticalStackLayout Grid.Row="2" Spacing="10" Margin="20,14,20,16">
            <Label x:Name="ErrorLabel" TextColor="{DynamicResource Danger}" FontSize="13" IsVisible="False" />
            <Button x:Name="ImportButton" Text="{loc:Translate Import}" Clicked="OnImportClicked"
                    BackgroundColor="{DynamicResource Lime}" TextColor="{DynamicResource LimeInk}"
                    FontAttributes="Bold" FontSize="16" HeightRequest="54" CornerRadius="16" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
