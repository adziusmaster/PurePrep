<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PurePrep"
             xmlns:loc="clr-namespace:PurePrep.Localization"
             x:Class="PurePrep.RecipeDetailPage"
             x:Name="PageRoot"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource Bg}">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Top bar -->
        <Grid Padding="20,12,20,0" ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8"
              MaximumWidthRequest="760" HorizontalOptions="Center">
            <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Surface}"
                    Stroke="{DynamicResource Line}" StrokeThickness="1" StrokeShape="RoundRectangle 14"
                    local:TapFeedback.IsEnabled="True" AutomationProperties.IsInAccessibleTree="True" AutomationProperties.Name="{loc:Translate Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Label Text="&#8249;" TextColor="{DynamicResource Ink}" FontSize="26"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Border Grid.Column="2" WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Surface}"
                    Stroke="{DynamicResource Line}" StrokeThickness="1" StrokeShape="RoundRectangle 14"
                    local:TapFeedback.IsEnabled="True" AutomationProperties.IsInAccessibleTree="True" AutomationProperties.Name="{loc:Translate Translate}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTranslateTapped" />
                </Border.GestureRecognizers>
                <Label Text="&#127760;" FontSize="18"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Border Grid.Column="3" WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Surface}"
                    Stroke="{DynamicResource Line}" StrokeThickness="1" StrokeShape="RoundRectangle 14"
                    local:TapFeedback.IsEnabled="True" AutomationProperties.IsInAccessibleTree="True" AutomationProperties.Name="{loc:Translate Edit}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnEditTapped" />
                </Border.GestureRecognizers>
                <Label Text="&#9998;" TextColor="{DynamicResource Ink}" FontSize="17"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Border Grid.Column="4" WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Surface}"
                    Stroke="{DynamicResource Line}" StrokeThickness="1" StrokeShape="RoundRectangle 14"
                    local:TapFeedback.IsEnabled="True" AutomationProperties.IsInAccessibleTree="True"
                    AutomationProperties.Name="{loc:Translate AddToShoppingList}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddToShoppingListTapped" />
                </Border.GestureRecognizers>
                <Label Text="&#128722;" FontSize="17"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Border Grid.Column="5" WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Surface}"
                    Stroke="{DynamicResource Line}" StrokeThickness="1" StrokeShape="RoundRectangle 14"
                    local:TapFeedback.IsEnabled="True" AutomationProperties.IsInAccessibleTree="True"
                    AutomationProperties.Name="{loc:Translate ShareRecipe}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnShareTapped" />
                </Border.GestureRecognizers>
                <Label Text="&#8599;" TextColor="{DynamicResource Ink}" FontSize="19"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Border Grid.Column="6" WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Surface}"
                    Stroke="{DynamicResource Line}" StrokeThickness="1" StrokeShape="RoundRectangle 14"
                    local:TapFeedback.IsEnabled="True" AutomationProperties.IsInAccessibleTree="True" AutomationProperties.Name="{loc:Translate Delete}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnDeleteTapped" />
                </Border.GestureRecognizers>
                <Label Text="&#128465;" TextColor="{DynamicResource Danger}" FontSize="17"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
        </Grid>

        <!-- Body -->
        <ScrollView Grid.Row="1" Padding="20,14,20,10">
            <VerticalStackLayout Spacing="22" MaximumWidthRequest="760" HorizontalOptions="Center">

                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Title}" TextColor="{DynamicResource Ink}" FontSize="28"
                           FontAttributes="Bold" LineHeight="1.1" />
                    <HorizontalStackLayout Spacing="7">
                        <Label Text="{Binding StepCount, Converter={StaticResource ResourceFormatConverter}, ConverterParameter=StepsCountFormat}"
                               TextColor="{DynamicResource Muted}" FontSize="13.5" />
                        <Label Text="&#183;" TextColor="{DynamicResource Faint}" FontSize="13.5" />
                        <Label Text="{Binding IngredientCount, Converter={StaticResource ResourceFormatConverter}, ConverterParameter=IngredientsCountFormat}"
                               TextColor="{DynamicResource Muted}" FontSize="13.5" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Spacing="6" IsVisible="{Binding HasSource}" Margin="0,2,0,0">
                        <Label Text="&#128279;" FontSize="12" TextColor="{DynamicResource Faint}"
                               VerticalOptions="Center" />
                        <Label Text="{Binding SourceHost}" TextColor="{DynamicResource Faint}"
                               FontSize="12.5" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Ingredients -->
                <VerticalStackLayout Spacing="12" IsVisible="{Binding HasIngredients}">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <Label Text="{loc:Translate SectionIngredients}" TextColor="{DynamicResource Lime}" FontSize="12"
                               CharacterSpacing="1.8" FontAttributes="Bold" VerticalOptions="Center" />
                        <!-- Serving scaler -->
                        <Border Grid.Column="1" BackgroundColor="{DynamicResource Surface}"
                                Stroke="{DynamicResource Line}" StrokeThickness="1"
                                Padding="3" StrokeShape="RoundRectangle 12">
                            <HorizontalStackLayout Spacing="2" BindableLayout.ItemsSource="{Binding ScaleOptions}">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate>
                                        <Border StrokeThickness="0" Padding="12,6" StrokeShape="RoundRectangle 9">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={x:Reference PageRoot}, Path=BindingContext.SelectScaleCommand}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Border.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{DynamicResource Lime}" />
                                                </DataTrigger>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="False">
                                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                                </DataTrigger>
                                            </Border.Triggers>
                                            <Label Text="{Binding Label}" FontSize="13.5" FontAttributes="Bold"
                                                   HorizontalOptions="Center" VerticalOptions="Center">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="TextColor" Value="{DynamicResource LimeInk}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="False">
                                                        <Setter Property="TextColor" Value="{DynamicResource Muted}" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>
                    <Label Text="{Binding ServingsCaption}" TextColor="{DynamicResource Muted}" FontSize="12.5"
                           HorizontalOptions="End" Margin="0,-6,2,0" />
                    <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            StrokeThickness="1" Padding="16,6" StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ScaledIngredients}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Padding="0,9">
                                        <Ellipse Fill="{DynamicResource Lime}" WidthRequest="6" HeightRequest="6"
                                                 VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding .}" TextColor="{DynamicResource Ink}"
                                               FontSize="15.5" LineHeight="1.2" VerticalOptions="Center" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Method -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate SectionMethod}" TextColor="{DynamicResource Lime}" FontSize="12"
                           CharacterSpacing="1.8" FontAttributes="Bold" />
                    <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding DisplaySteps}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                                        StrokeThickness="1" Padding="14" StrokeShape="RoundRectangle 16">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                        <Border WidthRequest="30" HeightRequest="30" BackgroundColor="{DynamicResource LimeWash}"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 10" VerticalOptions="Start">
                                            <Label Text="{Binding Order}" TextColor="{DynamicResource LimeBright}"
                                                   FontSize="14" FontAttributes="Bold"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                        <Label Grid.Column="1" Text="{Binding Instruction}" TextColor="{DynamicResource Ink}"
                                               FontSize="15.5" LineHeight="1.28" VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Cook CTA -->
        <Border Grid.Row="2" BackgroundColor="{DynamicResource Bg}" Padding="20,10,20,16">
            <Button Text="{loc:Translate StartCooking}" Clicked="OnCookClicked"
                    BackgroundColor="{DynamicResource Lime}" TextColor="{DynamicResource LimeInk}"
                    FontAttributes="Bold" FontSize="16" HeightRequest="54" CornerRadius="16"
                    MaximumWidthRequest="760" HorizontalOptions="Fill" />
        </Border>

        <!-- Busy overlay (translation / model download) -->
        <Grid x:Name="BusyOverlay" Grid.RowSpan="3" IsVisible="False"
              BackgroundColor="#B3000000">
            <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                    StrokeThickness="1" StrokeShape="RoundRectangle 16" Padding="26,22"
                    VerticalOptions="Center" HorizontalOptions="Center">
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="{Binding Source={x:Reference BusyOverlay}, Path=IsVisible}"
                                       Color="{DynamicResource Lime}" HorizontalOptions="Center" />
                    <Label x:Name="BusyLabel" Text="{loc:Translate TranslateWorking}"
                           TextColor="{DynamicResource Ink}" FontSize="15" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
