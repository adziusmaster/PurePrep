<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:PurePrep"
             xmlns:loc="clr-namespace:PurePrep.Localization"
             x:Class="PurePrep.SettingsPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource Bg}">

    <Grid>
        <ScrollView x:Name="ContentRoot">
            <Grid MaximumWidthRequest="760" HorizontalOptions="Center"
                  Padding="20,12,20,24" RowDefinitions="Auto,Auto" RowSpacing="22">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Surface}"
                        Stroke="{DynamicResource Line}" StrokeThickness="1" StrokeShape="RoundRectangle 14"
                        local:TapFeedback.IsEnabled="True" AutomationProperties.IsInAccessibleTree="True" AutomationProperties.Name="{loc:Translate Back}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="&#8249;" TextColor="{DynamicResource Ink}" FontSize="26"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Grid.Column="1" Text="{loc:Translate Settings}" TextColor="{DynamicResource Ink}"
                       FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout Grid.Row="1" Spacing="26">

                <!-- Appearance -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate SectionAppearance}" TextColor="{DynamicResource Muted}" FontSize="11.5"
                           CharacterSpacing="1.8" FontAttributes="Bold" />
                    <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            StrokeThickness="1" Padding="6" StrokeShape="RoundRectangle 18">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                            <Border x:Name="SystemPill" StrokeThickness="0" Padding="0,12"
                                    StrokeShape="RoundRectangle 13" local:TapFeedback.IsEnabled="True">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSystemTapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="SystemLabel" Text="{loc:Translate ThemeSystem}" FontSize="14" FontAttributes="Bold"
                                       HorizontalOptions="Center" />
                            </Border>
                            <Border x:Name="LightPill" Grid.Column="1" StrokeThickness="0" Padding="0,12"
                                    StrokeShape="RoundRectangle 13" local:TapFeedback.IsEnabled="True">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLightTapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="LightLabel" Text="{loc:Translate ThemeLight}" FontSize="14" FontAttributes="Bold"
                                       HorizontalOptions="Center" />
                            </Border>
                            <Border x:Name="DarkPill" Grid.Column="2" StrokeThickness="0" Padding="0,12"
                                    StrokeShape="RoundRectangle 13" local:TapFeedback.IsEnabled="True">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDarkTapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="DarkLabel" Text="{loc:Translate ThemeDark}" FontSize="14" FontAttributes="Bold"
                                       HorizontalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>
                    <Label Text="{loc:Translate AppearanceDesc}"
                           TextColor="{DynamicResource Faint}" FontSize="12.5" />
                </VerticalStackLayout>

                <!-- Units -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate SectionUnits}" TextColor="{DynamicResource Muted}" FontSize="11.5"
                           CharacterSpacing="1.8" FontAttributes="Bold" />
                    <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            StrokeThickness="1" Padding="6" StrokeShape="RoundRectangle 18">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                            <Border x:Name="UnitsSourcePill" StrokeThickness="0" Padding="0,12"
                                    StrokeShape="RoundRectangle 13" local:TapFeedback.IsEnabled="True">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnUnitsSourceTapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="UnitsSourceLabel" Text="{loc:Translate UnitsSource}" FontSize="14" FontAttributes="Bold"
                                       HorizontalOptions="Center" />
                            </Border>
                            <Border x:Name="UnitsMetricPill" Grid.Column="1" StrokeThickness="0" Padding="0,12"
                                    StrokeShape="RoundRectangle 13" local:TapFeedback.IsEnabled="True">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnUnitsMetricTapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="UnitsMetricLabel" Text="{loc:Translate UnitsMetric}" FontSize="14" FontAttributes="Bold"
                                       HorizontalOptions="Center" />
                            </Border>
                            <Border x:Name="UnitsImperialPill" Grid.Column="2" StrokeThickness="0" Padding="0,12"
                                    StrokeShape="RoundRectangle 13" local:TapFeedback.IsEnabled="True">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnUnitsImperialTapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="UnitsImperialLabel" Text="{loc:Translate UnitsImperial}" FontSize="14" FontAttributes="Bold"
                                       HorizontalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>
                    <Label Text="{loc:Translate UnitsDesc}"
                           TextColor="{DynamicResource Faint}" FontSize="12.5" />
                </VerticalStackLayout>

                <!-- Smart credits -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate SectionSmartCredits}" TextColor="{DynamicResource Muted}" FontSize="11.5"
                           CharacterSpacing="1.8" FontAttributes="Bold" />
                    <Border x:Name="BuyCreditsCard" BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            StrokeThickness="1" Padding="16,14" StrokeShape="RoundRectangle 18" local:TapFeedback.IsEnabled="True">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnBuyCreditsTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{loc:Translate BuyCredits}" TextColor="{DynamicResource Ink}"
                                       FontSize="16" FontAttributes="Bold" />
                                <Label Text="{loc:Translate BuyCreditsDesc}"
                                       TextColor="{DynamicResource Muted}" FontSize="13" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="&#8250;" TextColor="{DynamicResource Muted}"
                                   FontSize="22" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            StrokeThickness="1" Padding="16,14" StrokeShape="RoundRectangle 18" local:TapFeedback.IsEnabled="True">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRedeemCodeTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{loc:Translate RedeemCode}" TextColor="{DynamicResource Ink}"
                                       FontSize="16" FontAttributes="Bold" />
                                <Label Text="{loc:Translate RedeemCodeDesc}"
                                       TextColor="{DynamicResource Muted}" FontSize="13" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="&#8250;" TextColor="{DynamicResource Muted}"
                                   FontSize="22" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Recipe language -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate SectionRecipeLanguage}" TextColor="{DynamicResource Muted}" FontSize="11.5"
                           CharacterSpacing="1.8" FontAttributes="Bold" />
                    <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            StrokeThickness="1" Padding="16,4" StrokeShape="RoundRectangle 18">
                        <Picker x:Name="RecipeLanguagePicker" TextColor="{DynamicResource Ink}"
                                TitleColor="{DynamicResource Muted}"
                                SelectedIndexChanged="OnRecipeLanguageChanged" />
                    </Border>
                    <Label Text="{loc:Translate RecipeLanguageDesc}"
                           TextColor="{DynamicResource Faint}" FontSize="12.5" />
                </VerticalStackLayout>

                <!-- Language -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate SectionLanguage}" TextColor="{DynamicResource Muted}" FontSize="11.5"
                           CharacterSpacing="1.8" FontAttributes="Bold" />
                    <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            StrokeThickness="1" Padding="16,4" StrokeShape="RoundRectangle 18">
                        <Picker x:Name="LanguagePicker" TextColor="{DynamicResource Ink}"
                                TitleColor="{DynamicResource Muted}"
                                SelectedIndexChanged="OnLanguageChanged" />
                    </Border>
                    <Label Text="{loc:Translate LanguageDesc}"
                           TextColor="{DynamicResource Faint}" FontSize="12.5" />
                    <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            StrokeThickness="1" Padding="16,14" StrokeShape="RoundRectangle 18" local:TapFeedback.IsEnabled="True">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLanguagePacksTapped" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{loc:Translate SectionLanguagePacks}" TextColor="{DynamicResource Ink}"
                                       FontSize="16" FontAttributes="Bold" />
                                <Label Text="{loc:Translate LanguagePacksDesc}"
                                       TextColor="{DynamicResource Muted}" FontSize="13" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="&#8250;" TextColor="{DynamicResource Muted}"
                                   FontSize="22" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Cooking -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate SectionCooking}" TextColor="{DynamicResource Muted}" FontSize="11.5"
                           CharacterSpacing="1.8" FontAttributes="Bold" />
                    <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            StrokeThickness="1" Padding="16,12" StrokeShape="RoundRectangle 18">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{loc:Translate KeepScreenAwake}" TextColor="{DynamicResource Ink}"
                                       FontSize="16" FontAttributes="Bold" />
                                <Label Text="{loc:Translate KeepScreenAwakeDesc}"
                                       TextColor="{DynamicResource Muted}" FontSize="13" />
                            </VerticalStackLayout>
                            <Switch x:Name="KeepAwakeSwitch" Grid.Column="1" VerticalOptions="Center"
                                    OnColor="{DynamicResource Lime}" ThumbColor="{DynamicResource BgElevated}"
                                    Toggled="OnKeepAwakeToggled" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- Backup -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate SectionBackup}" TextColor="{DynamicResource Muted}" FontSize="11.5"
                           CharacterSpacing="1.8" FontAttributes="Bold" />
                    <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            StrokeThickness="1" Padding="16,14" StrokeShape="RoundRectangle 18"
                            local:TapFeedback.IsEnabled="True">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnExportTapped" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{loc:Translate ExportRecipes}" TextColor="{DynamicResource Ink}"
                                   FontSize="15" FontAttributes="Bold" />
                            <Label Text="{loc:Translate ExportRecipesHint}" TextColor="{DynamicResource Muted}"
                                   FontSize="12.5" />
                        </VerticalStackLayout>
                    </Border>
                    <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            StrokeThickness="1" Padding="16,14" StrokeShape="RoundRectangle 18"
                            local:TapFeedback.IsEnabled="True">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnImportTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="{loc:Translate ImportRecipes}" TextColor="{DynamicResource Ink}"
                               FontSize="15" FontAttributes="Bold" />
                    </Border>
                </VerticalStackLayout>

                <!-- About -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate SectionAbout}" TextColor="{DynamicResource Muted}" FontSize="11.5"
                           CharacterSpacing="1.8" FontAttributes="Bold" />
                    <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            StrokeThickness="1" Padding="16,14" StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{loc:Translate Version}" TextColor="{DynamicResource Ink}" FontSize="15" />
                                <Label x:Name="VersionLabel" Grid.Column="1" Text="1.2.3"
                                       TextColor="{DynamicResource Muted}" FontSize="15" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{DynamicResource Line}" />
                            <Label Text="{loc:Translate PrivacyPolicy}" TextColor="{DynamicResource Lime}" FontSize="15"
                                   FontAttributes="Bold">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPrivacyTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Grid>
        </ScrollView>

        <!-- Light scrim (tap outside the sheet to dismiss); background is blurred natively on Android. -->
        <BoxView x:Name="BuySheetScrim" Color="#26000000" IsVisible="False" AutomationProperties.IsInAccessibleTree="True" AutomationProperties.Name="{loc:Translate Close}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDismissBuySheet" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Buy-credits sheet (mirrors the main paywall). Pack buttons are built in code-behind from
             the live Play prices so the displayed price matches checkout. -->
        <Border x:Name="BuySheet" IsVisible="False"
                BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource LimeDim}"
                StrokeThickness="1" Padding="18" Margin="14,0,14,18" StrokeShape="RoundRectangle 22"
                VerticalOptions="End" MaximumWidthRequest="720" HorizontalOptions="Center">
            <VerticalStackLayout Spacing="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Label Text="{loc:Translate BuyCreditsChoosePack}" TextColor="{DynamicResource Ink}"
                           FontSize="17" FontAttributes="Bold" VerticalOptions="Center" />
                    <Border Grid.Column="1" WidthRequest="32" HeightRequest="32"
                            BackgroundColor="{DynamicResource BgElevated}" Stroke="{DynamicResource Line}"
                            StrokeThickness="1" StrokeShape="RoundRectangle 16"
                            VerticalOptions="Start" HorizontalOptions="End" local:TapFeedback.IsEnabled="True">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnDismissBuySheet" />
                        </Border.GestureRecognizers>
                        <Label Text="&#10005;" TextColor="{DynamicResource Muted}" FontSize="14"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </Grid>

                <VerticalStackLayout x:Name="BuyPackContainer" Spacing="8" />

                <ActivityIndicator x:Name="BuyBusyIndicator" IsRunning="False" IsVisible="False"
                                   Color="{DynamicResource Lime}" HeightRequest="24" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
