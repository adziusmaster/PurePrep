<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PurePrep.Localization"
             x:Class="PurePrep.SettingsPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource Bg}">

    <ScrollView>
        <Grid MaximumWidthRequest="760" HorizontalOptions="Center"
              Padding="20,12,20,24" RowDefinitions="Auto,Auto" RowSpacing="22">

            <!-- Header -->
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                <Border WidthRequest="42" HeightRequest="42" BackgroundColor="{DynamicResource Surface}"
                        Stroke="{DynamicResource Line}" StrokeThickness="1" StrokeShape="RoundRectangle 13">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBackTapped" />
                    </Border.GestureRecognizers>
                    <Label Text="&#8249;" TextColor="{DynamicResource Ink}" FontSize="26"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Grid.Column="1" Text="{loc:Translate Settings}" TextColor="{DynamicResource Ink}"
                       FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />
            </Grid>

            <VerticalStackLayout Grid.Row="1" Spacing="26">

                <!-- Appearance -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate SectionAppearance}" TextColor="{DynamicResource Muted}" FontSize="11.5"
                           CharacterSpacing="1.8" FontAttributes="Bold" />
                    <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            StrokeThickness="1" Padding="6" StrokeShape="RoundRectangle 18">
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                            <Border x:Name="SystemPill" StrokeThickness="0" Padding="0,12"
                                    StrokeShape="RoundRectangle 13">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSystemTapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="SystemLabel" Text="{loc:Translate ThemeSystem}" FontSize="14" FontAttributes="Bold"
                                       HorizontalOptions="Center" />
                            </Border>
                            <Border x:Name="LightPill" Grid.Column="1" StrokeThickness="0" Padding="0,12"
                                    StrokeShape="RoundRectangle 13">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnLightTapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="LightLabel" Text="{loc:Translate ThemeLight}" FontSize="14" FontAttributes="Bold"
                                       HorizontalOptions="Center" />
                            </Border>
                            <Border x:Name="DarkPill" Grid.Column="2" StrokeThickness="0" Padding="0,12"
                                    StrokeShape="RoundRectangle 13">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDarkTapped" />
                                </Border.GestureRecognizers>
                                <Label x:Name="DarkLabel" Text="{loc:Translate ThemeDark}" FontSize="14" FontAttributes="Bold"
                                       HorizontalOptions="Center" />
                            </Border>
                        </Grid>
                    </Border>
                    <Label Text="{loc:Translate AppearanceDesc}"
                           TextColor="{DynamicResource Faint}" FontSize="12.5" />
                </VerticalStackLayout>

                <!-- Language -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate SectionLanguage}" TextColor="{DynamicResource Muted}" FontSize="11.5"
                           CharacterSpacing="1.8" FontAttributes="Bold" />
                    <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            StrokeThickness="1" Padding="16,4" StrokeShape="RoundRectangle 18">
                        <Picker x:Name="LanguagePicker" TextColor="{DynamicResource Ink}"
                                TitleColor="{DynamicResource Muted}"
                                SelectedIndexChanged="OnLanguageChanged" />
                    </Border>
                    <Label Text="{loc:Translate LanguageDesc}"
                           TextColor="{DynamicResource Faint}" FontSize="12.5" />
                </VerticalStackLayout>

                <!-- Cooking -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate SectionCooking}" TextColor="{DynamicResource Muted}" FontSize="11.5"
                           CharacterSpacing="1.8" FontAttributes="Bold" />
                    <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            StrokeThickness="1" Padding="16,12" StrokeShape="RoundRectangle 18">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="3">
                                <Label Text="{loc:Translate KeepScreenAwake}" TextColor="{DynamicResource Ink}"
                                       FontSize="16" FontAttributes="Bold" />
                                <Label Text="{loc:Translate KeepScreenAwakeDesc}"
                                       TextColor="{DynamicResource Muted}" FontSize="13" />
                            </VerticalStackLayout>
                            <Switch x:Name="KeepAwakeSwitch" Grid.Column="1" VerticalOptions="Center"
                                    OnColor="{DynamicResource Lime}" ThumbColor="{DynamicResource BgElevated}"
                                    Toggled="OnKeepAwakeToggled" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

                <!-- About -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="{loc:Translate SectionAbout}" TextColor="{DynamicResource Muted}" FontSize="11.5"
                           CharacterSpacing="1.8" FontAttributes="Bold" />
                    <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Line}"
                            StrokeThickness="1" Padding="16,14" StrokeShape="RoundRectangle 18">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="{loc:Translate Version}" TextColor="{DynamicResource Ink}" FontSize="15" />
                                <Label x:Name="VersionLabel" Grid.Column="1" Text="1.0"
                                       TextColor="{DynamicResource Muted}" FontSize="15" />
                            </Grid>
                            <BoxView HeightRequest="1" Color="{DynamicResource Line}" />
                            <Label Text="{loc:Translate PrivacyPolicy}" TextColor="{DynamicResource Lime}" FontSize="15"
                                   FontAttributes="Bold">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnPrivacyTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
