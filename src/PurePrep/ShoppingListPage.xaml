<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:PurePrep.Localization"
             xmlns:local="clr-namespace:PurePrep"
             x:Class="PurePrep.ShoppingListPage"
             x:Name="PageRoot"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{DynamicResource Bg}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20,12,20,16" RowSpacing="14"
          MaximumWidthRequest="760" HorizontalOptions="Center">

        <!-- Header -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
            <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{DynamicResource Surface}"
                    Stroke="{DynamicResource Line}" StrokeThickness="1" StrokeShape="RoundRectangle 14"
                    local:TapFeedback.IsEnabled="True"
                    AutomationProperties.IsInAccessibleTree="True"
                    AutomationProperties.Name="{loc:Translate Back}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackTapped" />
                </Border.GestureRecognizers>
                <Label Text="&#8249;" TextColor="{DynamicResource Ink}" FontSize="26"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <Label Text="{loc:Translate ShoppingList}" TextColor="{DynamicResource Ink}"
                       FontSize="22" FontAttributes="Bold" />
                <Label x:Name="CountLabel" TextColor="{DynamicResource Muted}" FontSize="13" />
            </VerticalStackLayout>
        </Grid>

        <!-- Items -->
        <CollectionView Grid.Row="1" x:Name="ItemsView" SelectionMode="None"
                        VerticalScrollBarVisibility="Never">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="0,4"
                          MinimumHeightRequest="48"
                          AutomationProperties.IsInAccessibleTree="True"
                          AutomationProperties.Name="{Binding Text}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnItemTapped" />
                        </Grid.GestureRecognizers>
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                  Color="{DynamicResource Lime}" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="{Binding Text}" TextColor="{DynamicResource Ink}" FontSize="16"
                                   TextDecorations="{Binding TextDecoration}"
                                   Opacity="{Binding IsChecked, Converter={StaticResource CheckedOpacityConverter}}" />
                            <Label Text="{Binding Source}" TextColor="{DynamicResource Faint}" FontSize="12"
                                   IsVisible="{Binding HasSource}" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="12" Padding="24,48" HorizontalOptions="Center">
                    <Border WidthRequest="72" HeightRequest="72" HorizontalOptions="Center"
                            BackgroundColor="{DynamicResource LimeWash}" Stroke="{DynamicResource LineSoft}"
                            StrokeThickness="1" StrokeShape="RoundRectangle 22">
                        <Label Text="&#128722;" FontSize="30"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="{loc:Translate ShoppingEmptyTitle}" TextColor="{DynamicResource Ink}"
                           FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Label Text="{loc:Translate ShoppingEmptyBody}" TextColor="{DynamicResource Muted}"
                           FontSize="14" HorizontalTextAlignment="Center" HorizontalOptions="Center"
                           MaximumWidthRequest="280" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- Actions -->
        <Grid Grid.Row="2" x:Name="ActionsRow" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Button Text="{loc:Translate ClearTicked}" Clicked="OnClearTickedClicked"
                    BackgroundColor="{DynamicResource Surface}" TextColor="{DynamicResource Ink}"
                    FontAttributes="Bold" FontSize="15" HeightRequest="52" CornerRadius="15" />
            <Button Grid.Column="1" Text="{loc:Translate ClearAll}" Clicked="OnClearAllClicked"
                    BackgroundColor="{DynamicResource Surface}" TextColor="{DynamicResource Danger}"
                    FontAttributes="Bold" FontSize="15" HeightRequest="52" CornerRadius="15" />
        </Grid>
    </Grid>
</ContentPage>
